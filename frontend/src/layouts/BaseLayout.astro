---
// Base layout — carries the SEO/GEO scaffolding forward from the
// Spoudaios build (Open Graph, Twitter Card, canonical URL, JSON-LD,
// async font loading, LCP image preload) without any of its content or
// branding. Fill in ORG_NAME/ORG_LOGO_PATH below once they're known.
import "../styles/global.css";
import "../styles/site.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import WhatsappFloat from "../components/ui/WhatsappFloat.astro";
import { organizationSchema as buildOrganizationSchema } from "../lib/schema";

const ORG_NAME = "Nuvion";
const ORG_LOGO_PATH = "/images/logo-horizontal-dark.png";

interface Props {
  title: string;
  description?: string;
  /** Absolute URL or local path (e.g. "/images/...") — resolved against astro.config's "site" if local. Used for Open Graph/Twitter Card previews. */
  image?: string;
  /** Local path to preload with high priority — use on whatever image is likely this page's LCP element (e.g. a hero image). */
  preloadImage?: string;
  /** Extra schema.org object(s) for this specific page (Article, BreadcrumbList, etc.) on top of the Organization/WebSite schema every page already gets. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Adds <meta name="robots" content="noindex, nofollow"> — for private experiments. Defaults to on for every page when
   * this whole build is a preview/staging deploy (PUBLIC_NOINDEX=true, set only in that deploy's own env — see
   * .github/workflows/deploy.yml and src/pages/robots.txt.ts), so a page never needs to opt into this itself; a real
   * production build simply never sets that variable, so this stays false there without anyone touching this file. */
  noindex?: boolean;
  /** Skips the shared footer (for pages that ship their own closing panel). */
  noFooter?: boolean;
}

const {
  title,
  description = `${ORG_NAME} — Arquitetura digital, SEO técnico e GEO (Generative Engine Optimization) para a nova era das buscas.`,
  image = ORG_LOGO_PATH,
  preloadImage,
  jsonLd,
  noindex = import.meta.env.PUBLIC_NOINDEX === "true",
  noFooter = false,
} = Astro.props;

const canonicalUrl = Astro.url.href;
const siteUrl = (Astro.site ?? Astro.url).href;
const absoluteImageUrl = image.startsWith("http") ? image : new URL(image, Astro.site ?? Astro.url).href;

const organizationSchema = buildOrganizationSchema(siteUrl);
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": siteUrl.endsWith("/") ? siteUrl + "#website" : siteUrl + "/#website",
  name: ORG_NAME,
  url: siteUrl,
  publisher: { "@id": siteUrl.endsWith("/") ? siteUrl + "#organization" : siteUrl + "/#organization" },
};
const pageSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* Applies the saved theme before first paint (no light→dark flash). `?theme=dark|light` also sets and saves it, handy for previewing. */}
    <script is:inline>
      (function () {
        document.documentElement.classList.add("js");
        try {
          var q = new URLSearchParams(location.search).get("theme");
          if (q === "dark" || q === "light") localStorage.setItem("nv-theme", q);
          var t = localStorage.getItem("nv-theme");
          document.documentElement.setAttribute("data-theme", t === "dark" ? "dark" : "light");
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* Link previews (WhatsApp, Facebook, Telegram, etc.) — see ShareButtons.astro if this project uses it. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={ORG_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImageUrl} />

    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

    {/* Fonts are SELF-HOSTED (public/fonts, @font-face in global.css): no connection to another server before the first paint
       (that connection was what kept moving the Lighthouse score between two "modes") and no visitor IP sent to Google.
       Variable woff2, Latin subset (covers Portuguese). Both are preloaded because both show in the first screen. */}
    <link rel="preload" href="/fonts/inter-tight-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />

    <slot name="head" />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} is:inline />
    {pageSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
    ))}
  </head>
  <body class="flex min-h-dvh flex-col">
    <Header />
    <div class="flex-1">
      <slot />
    </div>
    {!noFooter && <Footer />}
    <WhatsappFloat />
    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
