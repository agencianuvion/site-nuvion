---
// Isolated layout for /teste-lp — a visual-direction experiment translating
// "Copy of LP Yuri/design_handoff_lp_iuri_chevalier"'s dark editorial system
// (Manrope + JetBrains Mono, OKLCH dark palette, hairline dividers, 0.7/1.3
// grid sections, parallax grid textures, scroll progress bar, cursor-follow
// glow, click ripple) onto Nuvion's actual home content, with the LP's blue
// accent swapped for Nuvion orange. Lives entirely outside BaseLayout/
// global.css's light system on purpose — this is a comparison page, not a
// replacement, until a direction is picked.
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<html lang="pt-BR" data-lp-test>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;0,800;1,300&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div id="lp-progress" aria-hidden="true"></div>
    <div id="lp-glow" aria-hidden="true"></div>
    <div id="lp-ripple-layer" aria-hidden="true"></div>

    <slot />

    <style is:global>
      [data-lp-test] {
        --bg: #0e1013;
        --bg-alt: #14171b;
        --panel: #16191d;
        --ink: #f4f3f2;
        --ink-muted: #b7b5b2;
        --ink-faint: #7c7a77;
        --line: #2c2f33;
        --line-faint: #383b40;
        --accent: #cc4e14;
        --accent-soft: rgba(204, 78, 20, 0.08);
        --accent-glow: rgba(204, 78, 20, 0.11);
        color-scheme: dark;

        /* Aliases so shared components built for the light site's token
           names (ThemeToggle.astro, etc.) resolve correctly here too,
           without forking them into LP-specific copies. */
        --color-nv-orange: var(--accent);
        --color-nv-graphite-500: var(--ink-faint);
        --color-nv-graphite-700: var(--ink-muted);
        --color-nv-graphite-900: var(--ink);
      }

      [data-lp-test] body {
        margin: 0;
        background: linear-gradient(160deg, var(--bg), #07090c 55%, var(--bg-alt));
        color: var(--ink);
        font-family: "Manrope", sans-serif;
        overflow-x: hidden;
        position: relative;
      }

      [data-lp-test] *,
      [data-lp-test] *::before,
      [data-lp-test] *::after {
        box-sizing: border-box;
      }

      [data-lp-test] ::selection {
        background: var(--accent);
        color: #060708;
      }

      #lp-progress {
        position: fixed;
        top: 0;
        left: 0;
        height: 2px;
        width: 0%;
        background: var(--accent);
        z-index: 9998;
        transition: width 0.12s linear;
      }
      #lp-glow {
        position: fixed;
        width: 420px;
        height: 420px;
        border-radius: 50%;
        pointer-events: none;
        z-index: 1;
        transform: translate(-50%, -50%);
        background: radial-gradient(circle, var(--accent-glow), transparent 70%);
        opacity: 0;
        transition: opacity 0.3s ease;
        filter: blur(6px);
      }
      #lp-ripple-layer {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 9997;
      }
      .lp-ripple-dot {
        position: absolute;
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: var(--accent);
        transform: translate(-50%, -50%) scale(0);
        opacity: 0.5;
        animation: lp-ripple-fade 0.9s ease-out forwards;
      }

      @keyframes lp-word-appear {
        0% {
          opacity: 0;
          transform: translateY(22px) scale(0.97);
          filter: blur(6px);
        }
        60% {
          opacity: 0.85;
          filter: blur(1px);
        }
        100% {
          opacity: 1;
          transform: translateY(0) scale(1);
          filter: blur(0);
        }
      }
      @keyframes lp-grow-h {
        from {
          width: 0;
        }
        to {
          width: 100%;
        }
      }
      @keyframes lp-grow-v {
        from {
          height: 0;
        }
        to {
          height: 100%;
        }
      }
      @keyframes lp-pulse-dot {
        0%,
        100% {
          opacity: 0.15;
          transform: translate(0, 0) scale(1);
        }
        30% {
          opacity: 0.85;
          transform: translate(3px, -6px) scale(1.6);
        }
        60% {
          opacity: 0.35;
          transform: translate(-4px, 3px) scale(1.1);
        }
      }
      @keyframes lp-float-particle {
        0%,
        100% {
          transform: translate(0, 0);
          opacity: 0.15;
        }
        25% {
          transform: translate(5px, -10px);
          opacity: 0.55;
        }
        50% {
          transform: translate(-3px, -5px);
          opacity: 0.35;
        }
        75% {
          transform: translate(7px, -15px);
          opacity: 0.7;
        }
      }
      @keyframes lp-ripple-fade {
        from {
          transform: translate(-50%, -50%) scale(0);
          opacity: 0.5;
        }
        to {
          transform: translate(-50%, -50%) scale(22);
          opacity: 0;
        }
      }
      @keyframes lp-scroll-x {
        from {
          transform: translateX(0);
        }
        to {
          transform: translateX(-50%);
        }
      }
      @keyframes lp-hero-float {
        0%,
        100% {
          transform: translateY(0) rotate(0deg);
        }
        50% {
          transform: translateY(-16px) rotate(-1deg);
        }
      }
      @keyframes lp-logo-sheen {
        0%,
        100% {
          filter: drop-shadow(0 0 0 transparent) brightness(1);
        }
        50% {
          filter: drop-shadow(0 0 14px var(--accent)) brightness(1.25);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        [data-lp-test] * {
          animation: none !important;
          transition: none !important;
        }
      }

      .lp-word {
        display: inline-block;
        opacity: 0;
        animation: lp-word-appear 0.8s ease-out forwards;
      }
      .lp-eyebrow {
        font-family: "JetBrains Mono", monospace;
        font-size: 11.5px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--accent);
      }
      .lp-cta {
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-family: "JetBrains Mono", monospace;
        font-size: 12.5px;
        font-weight: 500;
        letter-spacing: 0.14em;
        color: var(--ink);
        border: 1px solid var(--line);
        padding: 16px 30px;
        border-radius: 2px;
        text-transform: uppercase;
        transition:
          border-color 0.3s ease,
          gap 0.3s ease,
          color 0.3s ease;
      }
      .lp-cta:hover {
        border-color: var(--accent);
        color: var(--accent);
        gap: 16px;
      }
      .lp-cta-filled {
        background: var(--accent);
        color: #0c0d0e;
        border-color: var(--accent);
        transition:
          gap 0.25s ease,
          box-shadow 0.25s ease;
      }
      .lp-cta-filled:hover {
        color: #0c0d0e;
        box-shadow: 0 14px 34px -8px var(--accent);
      }
      .lp-grid-tile {
        background-image:
          linear-gradient(var(--line-faint) 1px, transparent 1px),
          linear-gradient(90deg, var(--line-faint) 1px, transparent 1px);
        background-size: 56px 56px;
      }
      .lp-hairline {
        border-top: 1px solid var(--line);
      }

      /* Every content section uses this 0.7fr/1.3fr label+content grid —
         collapses to one column on narrow screens instead of squeezing
         two columns into a few characters of width each. */
      .lp-grid-2col {
        display: grid;
        grid-template-columns: 0.7fr 1.3fr;
        gap: 40px;
      }
      @media (max-width: 760px) {
        .lp-grid-2col {
          grid-template-columns: 1fr;
          gap: 24px;
        }
        .lp-grid-2col > div:empty {
          display: none;
        }
      }
    </style>

    <script>
      // Scroll progress bar + nav background toggle + parallax — shared
      // rAF-free direct scroll handler (matches the design reference's own
      // approach) since this is a one-off test page, not production.
      const progress = document.getElementById("lp-progress");
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const onScroll = () => {
        const y = window.scrollY;
        const docH = document.documentElement.scrollHeight - window.innerHeight;
        const pct = docH > 0 ? Math.min(100, (y / docH) * 100) : 0;
        if (progress) progress.style.width = pct + "%";
        // Nav background transition lives in LpNav.astro's own script now.
        if (!reducedMotion) {
          document.querySelectorAll<HTMLElement>("[data-parallax]").forEach((el) => {
            if (el.dataset.baseTop === undefined) {
              const prevTransform = el.style.transform;
              el.style.transform = "none";
              el.dataset.baseTop = String(el.getBoundingClientRect().top + window.scrollY + el.offsetHeight / 2);
              el.style.transform = prevTransform;
            }
            const baseCenter = parseFloat(el.dataset.baseTop);
            const factor = parseFloat(el.dataset.parallax ?? "0.1");
            const offset = (baseCenter - window.scrollY - window.innerHeight / 2) * factor;
            el.style.transform = `translateY(${offset}px)`;
          });
        }
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();

      if (!reducedMotion) {
        const glow = document.getElementById("lp-glow");
        window.addEventListener("mousemove", (e) => {
          if (!glow) return;
          glow.style.left = e.clientX + "px";
          glow.style.top = e.clientY + "px";
          glow.style.opacity = "1";
        });
        window.addEventListener("mouseleave", () => {
          if (glow) glow.style.opacity = "0";
        });

        const rippleLayer = document.getElementById("lp-ripple-layer");
        window.addEventListener("click", (e) => {
          if (!rippleLayer) return;
          const dot = document.createElement("div");
          dot.className = "lp-ripple-dot";
          dot.style.left = e.clientX + "px";
          dot.style.top = e.clientY + "px";
          rippleLayer.appendChild(dot);
          setTimeout(() => dot.remove(), 950);
        });
      }
    </script>
  </body>
</html>
