---
// Closing conversion band — the site's last, most direct push before the
// footer. Light section (see Manifesto.astro's note — the whole site
// stays light until a dark mode toggle exists), using a bordered card and
// the orange glow for weight instead of a dark bg. The primary button
// gets a subtle "magnetic" hover (nudges toward the cursor within its own
// bounds) as the one indulgent micro-interaction on the page, skipped
// entirely for touch pointers and prefers-reduced-motion.
import { waLink, CONTACT } from "../../lib/contact";

interface Props {
  eyebrow?: string;
  description?: string;
  buttonLabel?: string;
  waMessage?: string;
}
const {
  eyebrow = "Vamos começar",
  description = "Agende um diagnóstico gratuito e descubra onde sua arquitetura digital está perdendo oportunidades, e o que fazer para reverter isso.",
  buttonLabel = "Agendar Meu Diagnóstico Gratuito",
  waMessage = "Olá! Quero agendar meu diagnóstico gratuito com a Nuvion.",
} = Astro.props;

const socials = [
  { label: "Instagram", href: CONTACT.instagram, icon: `<rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.2" cy="6.8" r="1"></circle>` },
  { label: "LinkedIn", href: CONTACT.linkedin, icon: `<path d="M6.5 9.5v9M6.5 6v.01"></path><path d="M11 18.5v-5.5a3 3 0 0 1 6 0v5.5M11 18.5v-6.5"></path>` },
  { label: "Facebook", href: CONTACT.facebook, icon: `<path d="M15 8.5h-2a2 2 0 0 0-2 2V21M9 13.5h6"></path><path d="M13 21V13"></path>` },
];
---

<section class="relative overflow-hidden bg-white py-20 text-center sm:py-24">
  <div
    class="pointer-events-none absolute left-1/2 top-1/2 h-[500px] w-[700px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-nv-orange/[0.08] blur-[130px]"
    aria-hidden="true"
  >
  </div>

  <div class="nv-reveal-up relative mx-auto max-w-2xl px-6 sm:px-10">
    <span class="text-xs font-semibold uppercase tracking-[0.32em] text-nv-orange sm:text-sm">{eyebrow}</span>
    <h2 class="nv-h1 mt-4 text-[32px] text-nv-graphite-900 sm:text-[52px]">
      Pronto para transformar seu site numa <strong>máquina de aquisição?</strong>
    </h2>
    <p class="mx-auto mt-5 max-w-lg text-pretty text-base leading-[1.6] text-nv-graphite-600 sm:text-lg">{description}</p>

    <div class="mt-9 flex justify-center">
      <a
        id="final-cta-button"
        href={waLink(waMessage)}
        target="_blank"
        rel="noopener"
        class="nv-cta inline-flex h-[54px] items-center justify-center whitespace-nowrap rounded-full bg-nv-orange px-9 text-base font-semibold text-white shadow-nv-accent"
      >
        {buttonLabel}
      </a>
    </div>

    <div class="mt-12 flex justify-center gap-3 border-t border-nv-hairline pt-8">
      <a
        href={waLink("Olá!")}
        target="_blank"
        rel="noopener"
        aria-label="WhatsApp"
        class="nv-nav flex h-10 w-10 items-center justify-center rounded-full border border-[rgba(42,42,42,.12)] bg-[#F5F5F5] text-nv-graphite-700"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" class="h-[18px] w-[18px]">
          <path d="M3 21l1.65-4.95A9 9 0 1 1 8.5 19.5z"></path>
          <path d="M8.5 8.5c0 3.5 3.5 7 7 7 .5 0 1-.5 1-1.5s-1-1.5-1.5-2-1 .5-1.5.5-2-1-2.5-1.5.5-1-.5-1.5-2-.5-2 0z"></path>
        </svg>
      </a>
      {socials.map((social) => (
          <a
            href={social.href}
            target="_blank"
            rel="noopener"
            aria-label={social.label}
            class="nv-nav flex h-10 w-10 items-center justify-center rounded-full border border-[rgba(42,42,42,.12)] bg-[#F5F5F5] text-nv-graphite-700"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" class="h-[18px] w-[18px]" set:html={social.icon} />
          </a>
        ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll(".nv-reveal-up").forEach((el) => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      el.classList.add("is-visible");
      return;
    }
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            el.classList.add("is-visible");
            observer.disconnect();
          }
        }
      },
      { threshold: 0.3 },
    );
    observer.observe(el);
  });

  // Magnetic button — only for fine pointers (mouse), never on touch, and
  // never under reduced motion.
  const button = document.getElementById("final-cta-button");
  const canHover = window.matchMedia("(pointer: fine)").matches;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (button && canHover && !reducedMotion) {
    button.addEventListener("mousemove", (event) => {
      const rect = button.getBoundingClientRect();
      const x = event.clientX - rect.left - rect.width / 2;
      const y = event.clientY - rect.top - rect.height / 2;
      button.style.transform = `translate(${x * 0.25}px, ${y * 0.25}px)`;
    });
    button.addEventListener("mouseleave", () => {
      button.style.transform = "";
    });
  }
</script>
