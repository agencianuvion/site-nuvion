---
// "Como Trabalhamos" — a plain, no-acronym process section. Carries the
// same substance as the old site's process narrative (diagnose → plan →
// execute → keep optimizing) without its retired proprietary name — see
// project memory on the Nuvion repositioning. Card treatment mirrors
// PillarsCarousel.astro's language (ghost numeral, icon, border+shadow,
// hover lift) so this doesn't read as a different, lower-effort section.
const steps = [
  {
    number: "01",
    title: "Diagnóstico",
    description:
      "Começamos entendendo a situação real do seu site e da sua presença nas buscas: o que já funciona, onde estão os gargalos técnicos e o que a concorrência já descobriu antes de você.",
    icon: `<circle cx="10.5" cy="10.5" r="6.5"></circle><line x1="15.2" y1="15.2" x2="21" y2="21"></line>`,
  },
  {
    number: "02",
    title: "Arquitetura & Estratégia",
    description:
      "Desenhamos um plano técnico claro, da estrutura do site ao calendário de SEO técnico e GEO, priorizado pelo que move o resultado mais rápido.",
    icon: `<circle cx="12" cy="12" r="9.5"></circle><polygon points="15.5 8.5 13 13 8.5 15.5 11 11 15.5 8.5"></polygon>`,
  },
  {
    number: "03",
    title: "Execução",
    description: "Colocamos tudo em prática com precisão: código, conteúdo estruturado e otimizações técnicas, sem atalhos que comprometam a performance.",
    icon: `<circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>`,
  },
  {
    number: "04",
    title: "Otimização Contínua",
    description:
      "Acompanhamos Core Web Vitals, rankings e o comportamento real dos usuários, e ajustamos o curso com dados, não com achismo.",
    icon: `<polyline points="3 16 9.5 9.5 13.5 13.5 21 6"></polyline><polyline points="14.5 6 21 6 21 12.5"></polyline>`,
  },
];
---

<section class="relative overflow-hidden bg-white py-24 sm:py-28">
  <div class="mx-auto max-w-6xl px-6 sm:px-10">
    <div class="mx-auto max-w-2xl text-center">
      <span class="text-xs font-semibold uppercase tracking-[0.32em] text-nv-orange sm:text-sm">Como trabalhamos</span>
      <h2 class="nv-h1 mt-4 text-[32px] text-nv-graphite-900 sm:text-[44px]">
        Um processo <strong>claro, do início ao contínuo.</strong>
      </h2>
    </div>

    <div id="process-steps" class="mt-16 grid grid-cols-1 gap-6 sm:mt-20 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, i) => (
        <div
          class="nv-process-step nv-perf group relative flex flex-col gap-5 overflow-hidden rounded-3xl border border-nv-hairline bg-white p-7 shadow-[0_2px_8px_rgba(30,30,30,.06)]"
          style={`transition-delay:${i * 0.12}s`}
        >
          <span class="pointer-events-none absolute -right-2 -top-6 select-none font-mono text-[96px] font-bold leading-none text-nv-orange/[0.06]" aria-hidden="true">
            {step.number}
          </span>
          <div class="relative flex h-12 w-12 items-center justify-center rounded-full border border-nv-orange/30 bg-white text-nv-orange transition-colors group-hover:bg-nv-orange group-hover:text-white">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" set:html={step.icon} />
          </div>
          <div class="relative flex flex-col gap-2.5">
            <span class="font-mono text-xs font-semibold tracking-[0.1em] text-nv-orange">{step.number}</span>
            <h3 class="text-lg font-semibold tracking-[-0.02em] text-nv-graphite-900">{step.title}</h3>
            <p class="text-pretty text-sm leading-[1.62] text-nv-graphite-600">{step.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .nv-process-step {
    opacity: 0;
    transform: translateY(24px);
    transition-property: opacity, transform;
    transition-duration: 0.6s;
    transition-timing-function: var(--ease-nv);
  }
  #process-steps.is-visible .nv-process-step {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const steps = document.getElementById("process-steps");
  if (steps) {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      steps.classList.add("is-visible");
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              steps.classList.add("is-visible");
              observer.disconnect();
            }
          }
        },
        { threshold: 0.2 },
      );
      observer.observe(steps);
    }
  }
</script>
