---
// "Statement" section — floating icon wave, the Performance Card, and a
// monumental H2. See design-reference/README.md, sections "2. Statement"
// and "3. Performance Card". Desktop and mobile use genuinely different
// copy (not just different sizes) — both are kept and toggled with
// Tailwind's responsive display utilities rather than picked at build time.
import PerformanceCard from "./PerformanceCard.astro";

const icons = [
  {
    orange: false,
