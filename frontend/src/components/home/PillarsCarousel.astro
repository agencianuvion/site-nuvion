---
// "Os três pilares" — horizontal scroll-snap carousel of the 3 core
// services. See design-reference/README.md, section "4. Carrossel 'Os
// três pilares'". The doc's own reveal/parallax note applies here too:
// production interactions are plain vanilla JS (scrollBy + scroll-driven
// arrow disabled-state), no framework needed.
import Eyebrow from "../ui/Eyebrow.astro";

const pillars = [
  {
    id: "sites-performance",
    number: "01",
    icon: `<rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M3 9h18M9 9v11"></path><path d="M12.5 13h6M12.5 16.5h6"></path>`,
    title: "Sites de Alta Performance",
    description:
      "Desenvolvimento focado em Core Web Vitals, usabilidade (UI/UX) e conversão. Plataformas estruturadas para reter a atenção e facilitar o rastreamento.",
    linkLabel: "Ver como construímos sites",
  },
  {
    id: "seo-tecnico",
    number: "02",
    icon: `<path d="M12 3 21 7.5 12 12 3 7.5z"></path><path d="M3 12l9 4.5 9-4.5"></path><path d="M3 16.5 12 21l9-4.5"></path>`,
    title: "SEO Técnico e Estrutural",
    description:
      "Otimização profunda do código e da arquitetura da informação. O alicerce necessário para dominar o topo dos buscadores com tráfego previsível.",
    linkLabel: "Entender o SEO técnico",
  },
  {
    id: "geo",
    number: "03",
    icon: `<circle cx="5" cy="6" r="2"></circle><circle cx="5" cy="18" r="2"></circle><circle cx="12" cy="12" r="2.4"></circle><circle cx="19" cy="6" r="2"></circle><circle cx="19" cy="18" r="2"></circle><path d="M6.8 7.1 10 10.3M6.8 16.9 10 13.7M14.1 10.4 17.3 7.3M14.1 13.6l3.2 3.1"></path>`,
    title: "Generative Engine Optimization (GEO)",
    description: "Posicionamento para a nova era das Inteligências Artificiais. Transformamos a sua marca na resposta oficial e confiável.",
    linkLabel: "Descobrir o GEO",
  },
];
---

<section class="overflow-hidden border-t border-[rgba(42,42,42,.08)] bg-nv-offwhite-light py-[72px] sm:py-24">
  <div class="mb-10 flex flex-col gap-3.5 px-[22px] sm:mb-12 sm:px-16">
    <Eyebrow>Os três pilares</Eyebrow>
    <h2 class="m-0 max-w-[20ch] text-[26px] font-medium leading-[1.08] tracking-[-0.035em] text-nv-graphite-900 sm:text-[clamp(30px,3.2vw,44px)]">
      O que sustenta um <strong class="font-extrabold">ecossistema previsível.</strong>
    </h2>
  </div>

  <div
    id="pillars-rail"
    class="nv-rail flex items-stretch gap-[18px] overflow-x-auto px-[22px] [scroll-padding-left:22px] [scroll-snap-type:x_mandatory] [scroll-behavior:smooth] sm:gap-7 sm:px-16 sm:[scroll-padding-left:64px]"
  >
    {pillars.map((pillar) => (
      <article class="flex w-[296px] flex-none flex-col [scroll-snap-align:start] sm:w-[520px]" id={pillar.id}>
        <div class="grid flex-1 grid-cols-1 gap-6 rounded-3xl border border-nv-hairline bg-white p-6 shadow-[0_2px_8px_rgba(30,30,30,.06)] sm:grid-cols-[92px_1fr] sm:gap-8 sm:rounded-[32px] sm:p-10 sm:pb-9">
          <div class="flex flex-row items-center gap-4 sm:flex-col sm:items-start sm:gap-[18px]">
            <span class="font-mono text-2xl font-semibold leading-none tracking-[-0.02em] text-nv-orange sm:text-[30px]">
              {pillar.number}
            </span>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="#CC4E14"
              stroke-width="1"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="block h-9 w-9 flex-none sm:h-11 sm:w-11"
              set:html={pillar.icon}
            />
          </div>
          <div class="flex flex-col items-start gap-3">
            <h3 class="m-0 text-xl font-semibold leading-[1.16] tracking-[-0.028em] text-nv-graphite-900 sm:text-2xl">
              {pillar.title}
            </h3>
            <p class="m-0 text-pretty text-base leading-[1.62] text-nv-graphite-600">{pillar.description}</p>
          </div>
        </div>
        <a href={`#${pillar.id}`} class="nv-more mt-5 inline-flex items-center gap-[7px] self-start text-sm font-medium no-underline">
          {pillar.linkLabel} <span aria-hidden="true">›</span>
        </a>
      </article>
    ))}
    <div class="w-2 flex-none" aria-hidden="true"></div>
  </div>

  <div class="mt-11 flex items-center justify-between gap-5 px-[22px] sm:px-16">
    <a
      href="#diagnostico"
      class="nv-cta inline-flex items-center justify-center whitespace-nowrap rounded-full bg-nv-orange px-[26px] py-[13px] text-[15px] font-semibold text-white shadow-nv-accent"
    >
      Estruturar meu projeto
    </a>
    <div class="flex gap-2.5">
      <button
        type="button"
        aria-label="Anterior"
        data-dir="-1"
        class="nv-nav flex h-11 w-11 items-center justify-center rounded-full border border-[rgba(42,42,42,.1)] bg-[#F0F0F0] p-0 text-nv-graphite-900"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="block h-[17px] w-[17px]">
          <polyline points="15 5 8 12 15 19"></polyline>
        </svg>
      </button>
      <button
        type="button"
        aria-label="Próximo"
        data-dir="1"
        class="nv-nav flex h-11 w-11 items-center justify-center rounded-full border border-[rgba(42,42,42,.1)] bg-[#F0F0F0] p-0 text-nv-graphite-900"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="block h-[17px] w-[17px]">
          <polyline points="9 5 16 12 9 19"></polyline>
        </svg>
      </button>
    </div>
  </div>
</section>

<script>
  const rail = document.getElementById("pillars-rail");
  const prevButton = document.querySelector<HTMLButtonElement>('[data-dir="-1"]');
  const nextButton = document.querySelector<HTMLButtonElement>('[data-dir="1"]');

  if (rail && prevButton && nextButton) {
    const scrollAmount = () => {
      const card = rail.querySelector("article");
      const gap = parseFloat(getComputedStyle(rail).columnGap || "0");
      return (card?.getBoundingClientRect().width ?? rail.clientWidth) + gap;
    };

    const updateButtons = () => {
      const maxScroll = rail.scrollWidth - rail.clientWidth;
      prevButton.disabled = rail.scrollLeft <= 1;
      nextButton.disabled = rail.scrollLeft >= maxScroll - 1;
    };

    prevButton.addEventListener("click", () => rail.scrollBy({ left: -scrollAmount(), behavior: "smooth" }));
    nextButton.addEventListener("click", () => rail.scrollBy({ left: scrollAmount(), behavior: "smooth" }));
    rail.addEventListener("scroll", updateButtons, { passive: true });
    updateButtons();
  }
</script>
