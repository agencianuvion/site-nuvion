---
// Mirrors the real site's Header.astro (sticky, full menu, theme toggle,
// mobile hamburger) rather than the reference LP's minimal fixed nav —
// same structure/behavior, restyled with this test's dark glass + Manrope/
// JetBrains Mono fonts instead of Inter Tight.
//
// Plain CSS classes throughout, not Tailwind utilities: this page doesn't
// import global.css (where `@import "tailwindcss"` lives), so Tailwind's
// generated stylesheet is never loaded here — every `flex`/`hidden`/
// `lg:flex`-style class silently does nothing on this route. Every other
// lp-test component avoided this by leaning on inline styles; this one
// needs real responsive (desktop nav vs. mobile menu) behavior, so it
// gets its own scoped <style> with media queries instead.
import { waLink } from "../../lib/contact";
import ThemeToggle from "../ui/ThemeToggle.astro";

const navLinks = [
  { href: "/sites-de-alta-performance", label: "Sites de Alta Performance" },
  { href: "/seo-tecnico", label: "SEO Técnico" },
  { href: "/geo", label: "Otimização Generativa" },
  { href: "/sobre-nos", label: "Sobre Nós" },
];
---

<header class="lp-header lp-header-bar">
  <a href="/" class="lp-logo-link" aria-label="Nuvion, página inicial">
    <img src="/images/logo-nuvion-light.png" alt="Nuvion" style="height:22px; display:block;" />
  </a>

  <nav class="lp-nav-desktop" aria-label="Main">
    {navLinks.map((link) => (
      <a href={link.href} class="lp-nav-link">
        {link.label}
      </a>
    ))}
    <ThemeToggle />
    <a href={waLink("Olá! Quero agendar um diagnóstico com a Nuvion.")} target="_blank" rel="noopener" class="lp-cta" style="height:38px; padding:0 20px; font-size:11px;">
      Agendar diagnóstico
    </a>
  </nav>

  <div class="lp-nav-mobile-trigger">
    <ThemeToggle />
    <button id="lp-mobile-menu-toggle" type="button" aria-label="Menu" aria-haspopup="true" aria-expanded="false" aria-controls="lp-mobile-menu" class="lp-burger">
      <svg viewBox="0 0 24 24" fill="none" style="width:22px; height:22px; display:block;" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <nav id="lp-mobile-menu" class="lp-mobile-menu" aria-label="Main (mobile)">
    {navLinks.map((link) => (
      <a href={link.href} class="lp-mobile-link">
        {link.label}
      </a>
    ))}
    <a href={waLink("Olá! Quero agendar um diagnóstico com a Nuvion.")} target="_blank" rel="noopener" class="lp-cta" style="margin-top:12px; height:40px; font-size:11px;">
      Agendar diagnóstico
    </a>
  </nav>
</header>

<style>
  .lp-header-bar {
    position: sticky;
    top: 0;
    z-index: 500;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 6vw;
  }
  .lp-header {
    background: rgba(7, 9, 12, 0);
    transition:
      background 0.3s ease,
      box-shadow 0.3s ease;
  }
  .lp-header.is-scrolled {
    background: rgba(7, 9, 12, 0.82);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }
  .lp-logo-link {
    display: block;
    flex-shrink: 0;
  }

  .lp-nav-desktop {
    display: none;
    align-items: center;
    gap: 32px;
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    color: var(--ink-muted);
  }
  .lp-nav-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .lp-nav-link:hover {
    color: var(--ink);
  }

  .lp-nav-mobile-trigger {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .lp-burger {
    color: var(--ink);
    background: none;
    border: none;
    padding: 0;
  }

  .lp-mobile-menu {
    display: none;
    flex-direction: column;
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    padding: 12px 6vw 20px;
    gap: 4px;
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    /* Always opaque + blurred, unlike the top bar itself — a dropdown
       overlaying page content needs to stay legible regardless of scroll
       position, not just once the user has scrolled past 40px. */
    background: rgba(7, 9, 12, 0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06);
  }
  .lp-mobile-menu.is-open {
    display: flex;
  }
  .lp-mobile-link {
    padding: 10px 0;
    color: var(--ink-muted);
    text-decoration: none;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 1024px) {
    .lp-nav-desktop {
      display: flex;
    }
    .lp-nav-mobile-trigger {
      display: none;
    }
  }
</style>

<script>
  const headers = document.querySelectorAll(".lp-header");
  const onScroll = () => {
    const scrolled = window.scrollY > 40;
    headers.forEach((h) => h.classList.toggle("is-scrolled", scrolled));
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  const toggle = document.getElementById("lp-mobile-menu-toggle");
  const menu = document.getElementById("lp-mobile-menu");
  toggle?.addEventListener("click", (event) => {
    event.stopPropagation();
    const isOpen = menu?.classList.toggle("is-open");
    toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
  });
  document.addEventListener("click", (event) => {
    if (menu && menu.classList.contains("is-open") && !menu.contains(event.target as Node) && event.target !== toggle) {
      menu.classList.remove("is-open");
      toggle?.setAttribute("aria-expanded", "false");
    }
  });
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.classList.remove("is-open");
    });
  });
</script>
