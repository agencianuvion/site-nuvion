---
const benefits = [
  { n: "01", title: "Processo claro, do diagnóstico à otimização contínua", desc: "Nada de caixa-preta. Você sabe exatamente o que está sendo feito e por quê, em cada etapa." },
  { n: "02", title: "Core Web Vitals reais, não só um site bonito", desc: "Performance é parte do design, não um ajuste de última hora antes de publicar." },
  { n: "03", title: "SEO técnico de verdade", desc: "Arquitetura de informação, schema markup e indexação, não só palavra-chave no título." },
  { n: "04", title: "GEO desde o primeiro dia", desc: "Preparado para aparecer também nas respostas de ChatGPT, Perplexity e outras IAs generativas." },
  { n: "05", title: "Dados abertos, sem vaidade métrica", desc: "Acompanhamento contínuo focado em resultado real, não em número que impressiona mas não converte." },
  { n: "06", title: "Um único time do início ao fim", desc: "Sem repasse de briefing entre terceiros. Quem planeja é quem executa." },
];
---

<section style="position:relative; overflow:hidden; background:var(--panel); padding:8vw 6vw;">
  <div data-parallax="-0.05" class="lp-grid-tile" style="position:absolute; inset:-15% -5%; opacity:0.18; pointer-events:none; z-index:0;"></div>
  <div style="position:relative; z-index:1; max-width:1100px; margin:0 auto;">
    <div style="display:flex; flex-direction:column; gap:16px; margin-bottom:24px;">
      <div class="lp-eyebrow">Diferenciais</div>
      <h2 style="font-family:'Manrope', sans-serif; font-weight:200; font-size:clamp(26px,3.2vw,40px); margin:0; color:var(--ink);">Por que trabalhar com a Nuvion</h2>
    </div>
    <div class="lp-grid-2col">
      <div></div>
      <div>
        {benefits.map((b) => (
          <div style="display:grid; grid-template-columns:64px 1fr; gap:20px; padding:26px 0; border-top:1px solid var(--line); align-items:baseline;">
            <div style="font-family:'JetBrains Mono', monospace; font-size:15px; color:var(--line-faint);">{b.n}</div>
            <div style="display:flex; flex-direction:column; gap:8px;">
              <div style="font-size:17px; color:var(--ink); font-weight:500;">{b.title}</div>
              <div style="font-size:14.5px; line-height:1.65; color:var(--ink-muted); max-width:52ch;">{b.desc}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
