---
const painPoints = [
  { n: "01", text: "Seu site foi lançado há anos e ninguém mexe nele desde então." },
  { n: "02", text: "Você só aparece no Google quando alguém já sabe o nome da sua marca." },
  { n: "03", text: "Um concorrente pior que você aparece na frente nas buscas." },
  { n: "04", text: "Seu site demora pra carregar e boa parte de quem clica desiste antes de ver a página." },
  { n: "05", text: "Quando alguém pergunta pro ChatGPT sobre o seu setor, sua marca nem aparece na resposta." },
  { n: "06", text: "Você investe em anúncio porque o site sozinho não traz ninguém." },
];
---

<section style="position:relative; overflow:hidden; background:var(--panel); padding:8vw 6vw;">
  <div data-parallax="0.06" class="lp-grid-tile" style="position:absolute; inset:-15% -5%; opacity:0.18; pointer-events:none; z-index:0;"></div>
  <div style="position:relative; z-index:1; max-width:1100px; margin:0 auto;">
    <div style="display:flex; flex-direction:column; gap:16px; margin-bottom:40px;">
      <div class="lp-eyebrow">O problema</div>
      <h2 style="font-family:'Manrope', sans-serif; font-weight:200; font-size:clamp(26px,3.2vw,40px); margin:0; color:var(--ink); max-width:32ch;">
        Se a sua empresa depende do digital, alguma dessas situações já aconteceu
      </h2>
    </div>
    <div class="lp-grid-2col">
      <div></div>
      <div class="lp-pain-grid">
        {painPoints.map((p) => (
          <div style="display:flex; gap:18px; padding:22px 0; border-top:1px solid var(--line);">
            <div style="font-family:'JetBrains Mono', monospace; font-size:13px; color:var(--accent); flex-shrink:0; padding-top:2px;">{p.n}</div>
            <div style="font-size:15px; line-height:1.6; color:var(--ink-muted);">{p.text}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .lp-pain-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 48px;
  }
  @media (max-width: 640px) {
    .lp-pain-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
