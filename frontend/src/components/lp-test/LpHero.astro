---
// Hero — LP Iuri's decorative system (grid tile, pulsing radial glow,
// growing dashed cross-lines, corner-intersection dots, floating
// particles, corner brackets, word-cascade reveal) layered over Nuvion's
// own hero video (kept per request, with a dark scrim + screen blend so
// it reads correctly against the new dark bg) instead of the LP's plain
// dark background. Stats are the honest 3-bullet list already used on the
// real site, not fabricated "X anos / Y projetos" counters — Nuvion
// doesn't have a public track record like that yet.
import { waLink } from "../../lib/contact";
---

<section style="position:relative; min-height:92vh; display:flex; flex-direction:column; justify-content:space-between; align-items:center; padding:120px 6vw 6vw; overflow:hidden;">
  <video
    id="lp-hero-video"
    muted
    loop
    playsinline
    disablepictureinpicture
    preload="metadata"
    poster="/images/hero-poster.webp"
    style="position:absolute; top:50%; left:0; transform:translateY(-50%); width:100%; height:680px; object-fit:cover; z-index:0; opacity:.55; mix-blend-mode:screen; pointer-events:none; mask-image:linear-gradient(180deg, transparent 0%, black 30%, black 75%, transparent 100%); -webkit-mask-image:linear-gradient(180deg, transparent 0%, black 30%, black 75%, transparent 100%);"
  >
    <source src="/videos/hero-loop-nuvion.mp4" type="video/mp4" />
  </video>
  <div style="position:absolute; inset:0; z-index:0; background:linear-gradient(180deg, rgba(14,16,19,.75) 0%, rgba(14,16,19,.3) 40%, rgba(14,16,19,.55) 75%, rgba(14,16,19,.95) 100%);"></div>

  <div class="lp-grid-tile" style="position:absolute; inset:0; opacity:0.22; mask-image:radial-gradient(ellipse 70% 60% at 50% 45%, black 40%, transparent 85%); -webkit-mask-image:radial-gradient(ellipse 70% 60% at 50% 45%, black 40%, transparent 85%);"></div>
  <div style="position:absolute; top:38%; left:50%; width:900px; height:900px; transform:translate(-50%,-50%); background:radial-gradient(circle, var(--accent-glow), transparent 68%); filter:blur(10px); animation:lp-pulse-dot 8s ease-in-out infinite;"></div>

  <div style="position:absolute; top:20%; left:0; width:100%; height:0; border-top:1px dashed var(--line-faint); animation:lp-grow-h 2s ease-out forwards; opacity:0.6;"></div>
  <div style="position:absolute; top:78%; left:0; width:100%; height:0; border-top:1px dashed var(--line-faint); animation:lp-grow-h 2s ease-out .3s forwards; opacity:0.6;"></div>
  <div style="position:absolute; top:0; left:18%; width:0; height:100%; border-left:1px dashed var(--line-faint); animation:lp-grow-v 2s ease-out .5s forwards; opacity:0.5;"></div>
  <div style="position:absolute; top:0; left:82%; width:0; height:100%; border-left:1px dashed var(--line-faint); animation:lp-grow-v 2s ease-out .7s forwards; opacity:0.5;"></div>
  <div style="position:absolute; top:20%; left:18%; width:5px; height:5px; margin:-2.5px; border-radius:50%; background:var(--accent); animation:lp-pulse-dot 3s ease-in-out 2s infinite;"></div>
  <div style="position:absolute; top:20%; left:82%; width:5px; height:5px; margin:-2.5px; border-radius:50%; background:var(--accent); animation:lp-pulse-dot 3s ease-in-out 2.2s infinite;"></div>
  <div style="position:absolute; top:78%; left:18%; width:5px; height:5px; margin:-2.5px; border-radius:50%; background:var(--accent); animation:lp-pulse-dot 3s ease-in-out 2.4s infinite;"></div>
  <div style="position:absolute; top:78%; left:82%; width:5px; height:5px; margin:-2.5px; border-radius:50%; background:var(--accent); animation:lp-pulse-dot 3s ease-in-out 2.6s infinite;"></div>

  {[
    [32, 12, 5], [58, 88, 6], [44, 8, 5.5], [70, 92, 6.5],
  ].map(([top, left, dur]) => (
    <div style={`position:absolute; top:${top}%; left:${left}%; width:2px; height:2px; border-radius:50%; background:var(--ink-muted); animation:lp-float-particle ${dur}s ease-in-out infinite;`}></div>
  ))}
  {[
    [14, 35], [10, 62], [26, 48], [64, 30], [60, 68], [88, 45], [6, 20], [92, 75],
  ].map(([top, left], i) => (
    <div style={`position:absolute; top:${top}%; left:${left}%; width:1.5px; height:1.5px; border-radius:50%; background:var(--ink); animation:lp-pulse-dot ${3.6 + i * 0.2}s ease-in-out ${i * 0.3}s infinite;`}></div>
  ))}

  <div style="position:absolute; top:24px; left:24px; width:32px; height:32px; border:1px solid var(--line-faint); opacity:0; animation:lp-word-appear 1s ease-out 3.4s forwards;"></div>
  <div style="position:absolute; top:24px; right:24px; width:32px; height:32px; border:1px solid var(--line-faint); opacity:0; animation:lp-word-appear 1s ease-out 3.5s forwards;"></div>
  <div style="position:absolute; bottom:24px; left:24px; width:32px; height:32px; border:1px solid var(--line-faint); opacity:0; animation:lp-word-appear 1s ease-out 3.6s forwards;"></div>
  <div style="position:absolute; bottom:24px; right:24px; width:32px; height:32px; border:1px solid var(--line-faint); opacity:0; animation:lp-word-appear 1s ease-out 3.7s forwards;"></div>

  <div style="position:relative; z-index:2; text-align:center;">
    <div style="font-family:'JetBrains Mono', monospace; font-size:12px; letter-spacing:0.28em; text-transform:uppercase; color:var(--ink-muted);">
      <span class="lp-word" style="animation-delay:0s;">Ecossistema</span>{" "}
      <span class="lp-word" style="animation-delay:.15s;">de</span>{" "}
      <span class="lp-word" style="animation-delay:.3s;">crescimento</span>
    </div>
    <div style="margin:16px auto 0; width:64px; height:1px; background:linear-gradient(90deg,transparent,var(--accent),transparent); opacity:0; animation:lp-word-appear 1s ease-out .55s forwards;"></div>
  </div>

  <div style="position:relative; z-index:2; text-align:center; max-width:1000px;">
    <div style="position:relative; display:inline-block; margin-bottom:22px;">
      <div style="position:absolute; top:50%; left:50%; width:300px; height:120px; transform:translate(-50%,-50%); background:radial-gradient(circle, var(--accent-glow), transparent 70%); filter:blur(14px); animation:lp-pulse-dot 4.5s ease-in-out infinite; z-index:-1;"></div>
      <img src="/images/logo-horizontal-white.png" alt="Nuvion" style="height:26px; display:block; opacity:0; animation:lp-word-appear .9s ease-out .55s forwards, lp-logo-sheen 4s ease-in-out 1.5s infinite;" />
    </div>
    <h1 style="font-family:'Manrope', sans-serif; font-weight:200; font-size:clamp(34px,6vw,68px); line-height:1.14; letter-spacing:-0.01em; margin:0 0 20px; color:var(--ink);">
      <span class="lp-word" style="animation-delay:.9s;">Arquitetura</span>{" "}
      <span class="lp-word" style="animation-delay:1.02s;">digital</span>{" "}
      <span class="lp-word" style="animation-delay:1.14s;">para</span>{" "}
      <span class="lp-word" style="animation-delay:1.26s;">a</span>
      <br />
      <span class="lp-word" style="animation-delay:1.42s; color:var(--ink); border-bottom:1.5px solid var(--accent);">nova</span>{" "}
      <span class="lp-word" style="animation-delay:1.54s; color:var(--ink); border-bottom:1.5px solid var(--accent);">era</span>{" "}
      <span class="lp-word" style="animation-delay:1.66s; color:var(--ink); border-bottom:1.5px solid var(--accent);">das</span>{" "}
      <span class="lp-word" style="animation-delay:1.78s; color:var(--ink); border-bottom:1.5px solid var(--accent);">buscas.</span>
    </h1>
    <p style="font-weight:300; font-size:clamp(15px,1.6vw,18px); line-height:1.65; color:var(--ink-muted); max-width:52ch; margin:0 auto; opacity:0; animation:lp-word-appear 1s ease-out 2.3s forwards;">
      Estruturamos o ecossistema digital do seu negócio para dominar SEO técnico, GEO e Core Web Vitals. O site
      deixa de ser cartão de visita e passa a operar como máquina de aquisição.
    </p>
  </div>

  <div style="position:relative; z-index:2; display:flex; flex-direction:column; align-items:center; gap:32px; opacity:0; animation:lp-word-appear 1s ease-out 3s forwards;">
    <a href={waLink("Olá! Quero agendar um diagnóstico com a Nuvion.")} target="_blank" rel="noopener" class="lp-cta">
      Agendar meu diagnóstico<span>→</span>
    </a>
    <div style="display:flex; flex-wrap:wrap; justify-content:center; align-items:center; gap:10px; row-gap:8px; padding:0 24px; font-family:'JetBrains Mono', monospace; font-size:10.5px; letter-spacing:0.14em; text-transform:uppercase; color:var(--ink-faint); text-align:center;">
      <span>Domine as buscas</span>
      <span aria-hidden="true" style="color:var(--accent);">·</span>
      <span>Sites otimizados para IA</span>
      <span aria-hidden="true" style="color:var(--accent);">·</span>
      <span>SEO técnico e GEO</span>
    </div>
  </div>
</section>

<script>
  const video = document.getElementById("lp-hero-video") as HTMLVideoElement | null;
  if (video) {
    const connection = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } })
      .connection;
    const isSlow = Boolean(connection?.saveData) || /\b2g\b/.test(connection?.effectiveType ?? "");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (isSlow || reducedMotion) {
      video.setAttribute("preload", "none");
      video.querySelectorAll("source").forEach((source) => source.remove());
    } else {
      const startPlayback = () => {
        requestAnimationFrame(() => {
          video.load();
          video.play().catch(() => {});
        });
      };
      window.addEventListener("load", startPlayback, { once: true });
      video.addEventListener("loadeddata", () => video.play().catch(() => {}), { once: true });
    }
  }
</script>
