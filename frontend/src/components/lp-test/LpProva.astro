---
// LP's "05 Prova" pattern, adapted: the reel/portfolio image grid becomes
// the real Performance Card metrics (Nuvion's actual proof point), and the
// testimonial cards keep the LP's own bracketed-placeholder convention —
// Nuvion has no published client quotes yet either, so these stay
// honest placeholders, not invented quotes. No logo marquee: unlike Iuri,
// there are no real client logos ready to show yet.
const metrics = [
  { value: "0,9s", label: "LCP" },
  { value: "0,00", label: "CLS" },
  { value: "112ms", label: "INP" },
  { value: "+184%", label: "Cliques" },
];
const scores = [
  { value: "99", label: "Performance" },
  { value: "100", label: "SEO" },
  { value: "98", label: "Acessível" },
];
const testimonialSlots = [
  "[ Depoimento com foco em resultado prático a inserir ]",
  "[ Depoimento com foco em processo de trabalho a inserir ]",
  "[ Depoimento com foco em qualidade técnica a inserir ]",
];
---

<section style="padding:8vw 6vw;">
  <div style="max-width:1200px; margin:0 auto;">
    <div style="display:flex; flex-direction:column; gap:16px; margin-bottom:48px;">
      <div class="lp-eyebrow">Prova</div>
      <h2 style="font-family:'Manrope', sans-serif; font-weight:200; font-size:clamp(26px,3.2vw,40px); margin:0; color:var(--ink);">Resultado, não promessa</h2>
    </div>

    <div style="border:1px solid var(--line); border-radius:2px; padding:36px 32px; margin-bottom:40px; display:flex; flex-wrap:wrap; gap:40px; align-items:center; justify-content:space-between;">
      <div style="display:flex; gap:28px;">
        {scores.map((s) => (
          <div style="text-align:center;">
            <div style="font-family:'JetBrains Mono', monospace; font-size:28px; color:var(--accent);">{s.value}</div>
            <div style="font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:var(--ink-faint); margin-top:6px;">{s.label}</div>
          </div>
        ))}
      </div>
      <div style="display:flex; gap:32px; flex-wrap:wrap;">
        {metrics.map((m) => (
          <div>
            <div style="font-family:'JetBrains Mono', monospace; font-size:16px; color:var(--ink);">{m.value}</div>
            <div style="font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:var(--ink-faint); margin-top:4px;">{m.label}</div>
          </div>
        ))}
      </div>
    </div>
    <p style="font-family:'JetBrains Mono', monospace; font-size:10.5px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-faint); margin:0 0 56px;">
      Auditoria real de um projeto Nuvion, não um número inventado.
    </p>

    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:1px; background:var(--line); border:1px solid var(--line);">
      {testimonialSlots.map((t) => (
        <div style="background:var(--bg); padding:30px 28px; display:flex; flex-direction:column; gap:16px;">
          <div style="font-family:'Manrope', sans-serif; font-size:44px; line-height:0.5; color:var(--accent); font-weight:200;">"</div>
          <div style="font-size:14.5px; line-height:1.65; color:var(--ink-faint); font-style:italic;">{t}</div>
        </div>
      ))}
    </div>
  </div>
</section>
