---
// Light/dark pill toggle, same idea as Astro's own dev error overlay
// switch. Sets data-theme on <html> and persists it to localStorage (the
// pre-paint read lives in BaseLayout's head script); the palette itself is
// the [data-theme="dark"] token block in global.css.
---

<div class="nv-theme-toggle" role="group" aria-label="Tema">
  <button type="button" data-theme-btn="light" aria-label="Tema claro" aria-pressed="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="4.5"></circle>
      <path d="M12 2.5v2M12 19.5v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2.5 12h2M19.5 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"></path>
    </svg>
  </button>
  <button type="button" data-theme-btn="dark" aria-label="Tema escuro" aria-pressed="false">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5z"></path>
    </svg>
  </button>
</div>

<style>
  .nv-theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border-radius: 999px;
    background: rgba(42, 42, 42, 0.06);
  }
  .nv-theme-toggle button {
    display: flex;
    height: 28px;
    width: 28px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    color: var(--color-nv-graphite-500);
    transition:
      background 0.16s ease,
      color 0.16s ease;
  }
  .nv-theme-toggle button svg {
    height: 15px;
    width: 15px;
  }
  .nv-theme-toggle button[aria-pressed="true"] {
    background: #fff;
    color: var(--color-nv-orange);
    box-shadow: 0 1px 3px rgba(30, 30, 30, 0.12);
  }
  :global(:root[data-theme="dark"]) .nv-theme-toggle {
    background: rgba(255, 255, 255, 0.08);
  }
  :global(:root[data-theme="dark"]) .nv-theme-toggle button[aria-pressed="true"] {
    background: #2c2f33;
    box-shadow: none;
  }
</style>

<script>
  const STORAGE_KEY = "nv-theme";
  const root = document.documentElement;
  let fadeTimer: ReturnType<typeof setTimeout> | null = null;

  function applyTheme(theme: "light" | "dark", animate = false) {
    // Only on a real switch (never on the very first, pre-paint apply on load) — that one must stay instant, or every
    // visitor would see a flash of the wrong theme animating into the right one.
    if (animate) {
      root.classList.add("theme-fade");
      if (fadeTimer) clearTimeout(fadeTimer);
      fadeTimer = setTimeout(() => root.classList.remove("theme-fade"), 350);
    }
    root.setAttribute("data-theme", theme);
    window.dispatchEvent(new CustomEvent("nv-theme-change", { detail: theme }));
    document.querySelectorAll<HTMLButtonElement>("[data-theme-btn]").forEach((btn) => {
      btn.setAttribute("aria-pressed", String(btn.dataset.themeBtn === theme));
    });
  }

  const saved = localStorage.getItem(STORAGE_KEY);
  applyTheme(saved === "dark" ? "dark" : "light");

  document.querySelectorAll<HTMLButtonElement>("[data-theme-btn]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const theme = btn.dataset.themeBtn === "dark" ? "dark" : "light";
      localStorage.setItem(STORAGE_KEY, theme);
      applyTheme(theme, true);
    });
  });
</script>
