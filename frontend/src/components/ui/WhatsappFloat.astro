---
// Floating WhatsApp button, on every page (mounted in BaseLayout). Orange brand button, bottom-right.
// Every CTA on the site resolves to WhatsApp, so this only makes the same door reachable from anywhere.
// On hover / keyboard focus the round button itself grows into a pill (one orange shape, the label is part of it).
import { waLink } from "../../lib/contact";
const href = waLink("Olá! Vim pelo site da Nuvion e quero conversar sobre o meu projeto.");
---

<a class="wa-float" href={href} target="_blank" rel="noopener" aria-label="Falar com a Nuvion no WhatsApp">
  <span class="wa-float-label" aria-hidden="true">Fale com a gente</span>
  <span class="wa-float-icon">
    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"></path>
      <path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"></path>
    </svg>
  </span>
</a>

<style>
  .wa-float {
    position: fixed;
    z-index: 40; /* under the header and its mobile menu */
    right: max(16px, env(safe-area-inset-right));
    bottom: max(16px, env(safe-area-inset-bottom));
    display: flex;
    align-items: center;
    height: 58px;
    border-radius: 999px;
    background: #ca4d13;
    color: #fff;
    text-decoration: none;
    box-shadow:
      0 10px 28px rgba(202, 77, 19, 0.45),
      0 2px 6px rgba(0, 0, 0, 0.25);
    transition:
      background 0.2s ease,
      transform 0.25s ease;
  }
  /* soft ring that pulses now and then, to notice it without being pushy (follows the shape as it grows) */
  .wa-float::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 2px solid #ca4d13;
    opacity: 0;
    animation: wa-ring 4.5s ease-out 3s infinite;
    pointer-events: none;
  }
  @keyframes wa-ring {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    35%,
    100% {
      transform: scale(1.35);
      opacity: 0;
    }
  }
  .wa-float-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
  }
  /* the label lives inside the same orange shape: it opens to the left of the icon */
  .wa-float-label {
    max-width: 0;
    overflow: hidden;
    padding-left: 0;
    white-space: nowrap;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.005em;
    opacity: 0;
    transition:
      max-width 0.4s cubic-bezier(0.2, 0.7, 0.2, 1),
      padding-left 0.4s cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 0.25s ease;
  }
  .wa-float:hover .wa-float-label,
  .wa-float:focus-visible .wa-float-label {
    max-width: 190px;
    padding-left: 24px;
    opacity: 1;
    transition-delay: 0s, 0s, 0.1s;
  }
  .wa-float:hover {
    background: #b8440f;
  }
  .wa-float:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }
  @media (hover: none) {
    .wa-float-label {
      display: none;
    }
  }
  @media (max-width: 899px) {
    .wa-float {
      right: max(14px, env(safe-area-inset-right));
      bottom: max(14px, env(safe-area-inset-bottom));
      height: 52px;
      transition:
        opacity 0.25s ease,
        transform 0.25s ease,
        background 0.2s ease;
    }
    .wa-float-icon {
      width: 52px;
      height: 52px;
    }
    .wa-float-icon svg {
      width: 26px;
      height: 26px;
    }
    /* hidden while the hero, the contact band or the closing panel (which already have the button) are on screen */
    .wa-float.is-away {
      opacity: 0;
      transform: translateY(16px);
      pointer-events: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wa-float::after {
      animation: none;
    }
    .wa-float,
    .wa-float-label {
      transition: none;
    }
  }
  @media print {
    .wa-float {
      display: none;
    }
  }
</style>

<script>
  // On phones, get out of the way while the page already shows a WhatsApp call to action.
  const fab = document.querySelector<HTMLElement>(".wa-float");
  if (fab && window.matchMedia("(max-width: 899px)").matches) {
    const zones = [...document.querySelectorAll<HTMLElement>(".t3-hero, .t3-band, .t3-cta")];
    if (zones.length) {
      const inView = new Set<Element>();
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => (e.isIntersecting ? inView.add(e.target) : inView.delete(e.target)));
        fab.classList.toggle("is-away", inView.size > 0);
      });
      zones.forEach((z) => io.observe(z));
    }
  }
</script>
