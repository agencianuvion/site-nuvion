---
import type { Post } from "../../types/content";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const href = `/blog/${post.slug}`;
---

<article class="flex flex-col gap-3 rounded-2xl border border-black/10 p-6">
  <img src={post.featuredImage} alt={post.title} loading="lazy" class="aspect-video w-full rounded-xl object-cover" />
  <h2 class="text-xl font-semibold">
    <a href={href} class="hover:underline">{post.title}</a>
  </h2>
  <p class="line-clamp-2 text-sm text-black/60">{post.excerpt}</p>
  {post.author && <p class="text-xs text-black/50">By {post.author}</p>}
  <a href={href} class="mt-auto w-fit text-sm font-medium underline underline-offset-2">
    Read →
  </a>
</article>
