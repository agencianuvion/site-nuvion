---
// A code-window card: window bar (dots + file name) and a few lines of a plain-text file, with light syntax colouring for
// Markdown (# title, > summary, ## section, - [link](url)). Decorative example, so it is hidden from assistive tech; the
// explanation of what the file is lives in the surrounding text and in the caption.
interface Props {
  file: string;
  lines: string[];
  caption?: string;
}
const { file, lines, caption } = Astro.props;

type Part = { k: "t" | "l" | "u"; v: string };
const parse = (s: string): Part[] => {
  const out: Part[] = [];
  const re = /\[([^\]]+)\]\(([^)]+)\)/g;
  let last = 0;
  let m: RegExpExecArray | null;
  while ((m = re.exec(s))) {
    if (m.index > last) out.push({ k: "t", v: s.slice(last, m.index) });
    out.push({ k: "l", v: "[" + m[1] + "]" }, { k: "u", v: "(" + m[2] + ")" });
    last = m.index + m[0].length;
  }
  if (last < s.length) out.push({ k: "t", v: s.slice(last) });
  return out;
};
const kind = (s: string) => (s.startsWith("## ") ? "h2" : s.startsWith("# ") ? "h1" : s.startsWith("> ") ? "q" : s.startsWith("- ") ? "li" : s === "" ? "gap" : "p");
---

<figure class="cc" data-reveal>
  <div class="cc-win" aria-hidden="true">
    <div class="cc-bar">
      <i></i><i></i><i></i>
      <span class="cc-file">{file}</span>
    </div>
    <pre class="cc-code"><code>{
      lines.map((ln, i) => (
        <span class={`cc-ln cc-${kind(ln)}`}><b class="cc-n">{String(i + 1).padStart(2, " ")}</b>{parse(ln).map((p) => <span class={`cc-${p.k}`}>{p.v}</span>)}{"\n"}</span>
      ))
    }<span class="cc-caret"></span></code></pre>
  </div>
  {caption && <figcaption class="cc-cap">{caption}</figcaption>}
</figure>

<style is:global>
  .cc {
    margin: 0;
    min-width: 0;
  }
  .cc-win {
    overflow: hidden;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: #08090b;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  }
  .cc-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 12px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
  }
  .cc-bar i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.16);
  }
  .cc-bar i:first-child {
    background: #cc4e14;
  }
  .cc-file {
    margin-left: 10px;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 11.5px;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.55);
  }
  .cc-code {
    margin: 0;
    padding: 16px 18px 20px;
    overflow-x: auto;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 12.5px;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.78);
    tab-size: 2;
  }
  .cc-code code {
    font: inherit;
  }
  .cc-n {
    display: inline-block;
    width: 2ch;
    margin-right: 16px;
    font-weight: 400;
    text-align: right;
    color: rgba(255, 255, 255, 0.22);
    user-select: none;
  }
  .cc-h1 .cc-t {
    color: #fff;
    font-weight: 600;
  }
  .cc-h2 .cc-t {
    color: #ff9a62;
    font-weight: 600;
  }
  .cc-q .cc-t {
    color: rgba(255, 255, 255, 0.55);
    font-style: italic;
  }
  .cc-l {
    color: #ff9a62;
  }
  .cc-u {
    color: rgba(255, 255, 255, 0.4);
  }
  .cc-caret {
    display: inline-block;
    width: 7px;
    height: 14px;
    margin-left: 44px;
    vertical-align: -2px;
    background: var(--color-nv-orange);
    animation: cc-blink 1.1s steps(1) infinite;
  }
  @keyframes cc-blink {
    50% {
      opacity: 0;
    }
  }
  .cc-cap {
    margin-top: 14px;
    font-size: 13.5px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.6);
  }
  @media (max-width: 600px) {
    .cc-code {
      font-size: 11px;
    }
    .cc-n {
      margin-right: 10px;
    }
  }
</style>
