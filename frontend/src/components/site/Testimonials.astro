---
// Testimonials: cards that slide in from the left over each other while the panel is pinned (scripts/site.ts, ".t3-testi").
// layout "stack" (home): cards slide over each other; layout "bento" (About): a slider (same script and controls as the projects
// slider on the home: swipe, drag, arrows, keyboard), so the page does not repeat the pinned stacking effect of the process
// section above it. Cards have a fixed width and equal height, so it works with any number of testimonials and any text length:
// a long quote scrolls inside its card (8 lines visible; same scroll wrapper and script as the stacked cards on the home).
// tone "light" is the home version (dark cards on a light panel, with the vertical client-logo column); tone "dark" puts the
// cards on a dark panel, and logos={false} drops the logo column (the About page shows the logos in their own section).
// The texts in lib/testimonials.ts are PLACEHOLDERS until the real ones arrive.
import { clientLogos } from "../../lib/clients";
import { testimonials } from "../../lib/testimonials";
import { COMPANY } from "../../lib/contact";

interface Props {
  layout?: "stack" | "bento";
  tone?: "light" | "dark";
  logos?: boolean;
  title?: string;
  em?: string;
}
const { layout = "stack", tone = "light", logos = true, title = "O que dizem nossos", em = "clientes" } = Astro.props;
const vlogoH = (l: { w: number; h: number }) => Math.round(Math.max(18, Math.min(44, 140 / (l.w / l.h))));
/** [true, true, true, false, false] for a 3-star rating — filled stars first, so the row is just a map over this. */
const stars = (n: number) => Array.from({ length: 5 }, (_, i) => i < n);
/**
 * A short testimonial gets a much bigger quote than a long one, so it fills roughly the same amount of the card
 * instead of leaving empty space above the name (the card's height is fixed — see .tsl's --tsl-h). Word count reads
 * more consistently across punctuation styles than character count. Long quotes land back at the original small
 * size and rely on the card's existing internal scroll (.t3-tqwrap's "is-scroll" class, in site.ts) as the fallback.
 */
function quoteFontSize(quote: string): string {
  const words = quote.trim().split(/\s+/).filter(Boolean).length;
  if (words <= 12) return "clamp(22px, 3.6vw, 34px)";
  if (words <= 25) return "clamp(19px, 3vw, 30px)";
  if (words <= 45) return "clamp(17px, 2.55vw, 26px)";
  if (words <= 80) return "clamp(16px, 2vw, 21px)";
  return "clamp(15px, 1.6vw, 18px)";
}
---

{
  layout === "bento" ? (
    <section class="t3-panel t3-dark t3-pad tb" aria-labelledby="t3-testi-h">
      <div class="t3-head">
        <h2 id="t3-testi-h" class="t3-title" data-t3-title>{title} <em>{em}</em></h2>
        <div class="t3-head-side">
          <span class="t3-chip"><i></i>Depoimentos</span>
          <a href={COMPANY.mapsUrl} target="_blank" rel="noopener" class="t3-btn-out">Ver mais depoimentos <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class:list={["t3-pslider tsl", { "is-solo": testimonials.length === 1 }]} data-pslider>
        <div class="t3-ptrack" role="region" aria-roledescription="carrossel" tabindex="0" aria-label="Depoimentos de clientes (use as setas do teclado para navegar)">
          {testimonials.map((t, i) => (
            <div class="t3-pslide" role="group" aria-roledescription="slide" aria-label={`${i + 1} de ${testimonials.length}`}>
          <article class:list={["tb-card", { "is-video": t.video }]}>
            {t.video && (
              <div class="t3-tvideo" aria-hidden="true">
                <span class="t3-tplay"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" /></svg></span>
              </div>
            )}
            <div class="tb-body">
              <svg class="t3-tquote" viewBox="0 0 32 24" aria-hidden="true"><path d="M0 24V13.6C0 6 4.2 1.2 12 0l1.2 3.6C8.8 4.8 6.8 7.2 6.4 10.8H12V24zm18 0V13.6C18 6 22.2 1.2 30 0l1.2 3.6C26.8 4.8 24.8 7.2 24.4 10.8H30V24z" /></svg>
              {t.rating && (
                <div class="t3-stars" role="img" aria-label={`${t.rating} de 5 estrelas`}>
                  {stars(t.rating).map((on) => (
                    <svg viewBox="0 0 20 20" class:list={{ "is-on": on }} aria-hidden="true"><path d="M10 1.3l2.55 5.9 6.4.56-4.85 4.28 1.46 6.3L10 15.25l-5.56 3.09 1.46-6.3L1.05 7.76l6.4-.56z" /></svg>
                  ))}
                </div>
              )}
              <div class="t3-tqwrap"><blockquote class="tb-q" style={`font-size:${quoteFontSize(t.quote)}`}>{t.quote}</blockquote></div>
              <footer class="t3-tby">
                <span class="t3-tavatar" aria-hidden="true">{t.photo && <img src={t.photo} alt="" width="44" height="44" loading="lazy" decoding="async" />}</span>
                <span class="t3-tby-info">
                  <strong>{t.name}</strong>
                  {t.role && <em>{t.role}</em>}
                  {t.fromGoogle && (
                    <span class="t3-gbadge" title="Avaliação do Google">
                      <svg viewBox="0 0 18 18" aria-hidden="true">
                        <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844a4.14 4.14 0 0 1-1.796 2.716v2.259h2.908c1.702-1.567 2.684-3.875 2.684-6.615z" />
                        <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.184l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z" />
                        <path fill="#FBBC05" d="M3.964 10.706A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.706V4.962H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.038l3.007-2.332z" />
                        <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.581C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.962L3.964 7.294C4.672 5.167 6.656 3.58 9 3.58z" />
                      </svg>
                      <span>Avaliação do Google</span>
                    </span>
                  )}
                </span>
              </footer>
            </div>
          </article>
            </div>
          ))}
        </div>
        {testimonials.length > 1 && (
          <div class="t3-pctrl">
            <span class="t3-pcount" aria-live="polite"><b data-pcur>01</b> / {String(testimonials.length).padStart(2, "0")}</span>
            <span class="t3-pprog" aria-hidden="true"><i data-pbar></i></span>
            <div class="t3-parrows">
              <button type="button" class="t3-parrow" data-pdir="-1" aria-label="Depoimento anterior">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
              </button>
              <button type="button" class="t3-parrow" data-pdir="1" aria-label="Próximo depoimento">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </button>
            </div>
          </div>
        )}
      </div>
    </section>
  ) : (
<section class:list={["t3-panel t3-pad t3-testi", tone === "dark" ? "t3-dark" : "t3-light"]} aria-labelledby="t3-testi-h">
  <div class="t3-head">
    <h2 id="t3-testi-h" class="t3-title" data-t3-title>{title} <em>{em}</em></h2>
    <div class="t3-head-side">
      <span class="t3-chip"><i></i>Depoimentos</span>
      <a href={COMPANY.mapsUrl} target="_blank" rel="noopener" class="t3-btn-out">Ver mais depoimentos <span aria-hidden="true">→</span></a>
    </div>
  </div>

  <div class:list={["t3-tgrid", { "is-solo": !logos }]}>
    <div class="t3-tcards">
      {
        testimonials.map((t, i) => (
          <article class:list={["t3-tcard", { "is-video": t.video }]} style={`--i:${i}`}>
            <div class="t3-tcard-in">
              {t.video && (
                <div class="t3-tvideo" aria-hidden="true">
                  <span class="t3-tplay"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" /></svg></span>
                </div>
              )}
              <div class="t3-tbody">
                <svg class="t3-tquote" viewBox="0 0 32 24" aria-hidden="true"><path d="M0 24V13.6C0 6 4.2 1.2 12 0l1.2 3.6C8.8 4.8 6.8 7.2 6.4 10.8H12V24zm18 0V13.6C18 6 22.2 1.2 30 0l1.2 3.6C26.8 4.8 24.8 7.2 24.4 10.8H30V24z" /></svg>
                {t.rating && (
                  <div class="t3-stars" role="img" aria-label={`${t.rating} de 5 estrelas`}>
                    {stars(t.rating).map((on) => (
                      <svg viewBox="0 0 20 20" class:list={{ "is-on": on }} aria-hidden="true"><path d="M10 1.3l2.55 5.9 6.4.56-4.85 4.28 1.46 6.3L10 15.25l-5.56 3.09 1.46-6.3L1.05 7.76l6.4-.56z" /></svg>
                    ))}
                  </div>
                )}
                <div class="t3-tqwrap"><blockquote class="t3-tq" style={`font-size:${quoteFontSize(t.quote)}`}>{t.quote}</blockquote></div>
                <footer class="t3-tby">
                  <span class="t3-tavatar" aria-hidden="true">{t.photo && <img src={t.photo} alt="" width="44" height="44" loading="lazy" decoding="async" />}</span>
                  <span class="t3-tby-info">
                    <strong>{t.name}</strong>
                    {t.role && <em>{t.role}</em>}
                    {t.fromGoogle && (
                      <span class="t3-gbadge" title="Avaliação do Google">
                        <svg viewBox="0 0 18 18" aria-hidden="true">
                          <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844a4.14 4.14 0 0 1-1.796 2.716v2.259h2.908c1.702-1.567 2.684-3.875 2.684-6.615z" />
                          <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.184l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z" />
                          <path fill="#FBBC05" d="M3.964 10.706A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.706V4.962H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.038l3.007-2.332z" />
                          <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.581C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.962L3.964 7.294C4.672 5.167 6.656 3.58 9 3.58z" />
                        </svg>
                        <span>Avaliação do Google</span>
                      </span>
                    )}
                  </span>
                </footer>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    {
      logos && (
        <div class="t3-tvcol" aria-label="Logos das empresas atendidas">
          <div class="t3-vm-track" role="list">
            {[0, 1].map((copy) =>
              clientLogos.map((l) => (
                <div class="t3-vm-item" role={copy === 0 ? "listitem" : undefined} aria-hidden={copy === 1 ? "true" : undefined}>
                  <img
                    src={l.src}
                    alt={copy === 0 ? l.name : ""}
                    width={l.w}
                    height={l.h}
                    loading="lazy"
                    decoding="async"
                    class="t3-vlogo"
                    style={`--lh:${vlogoH(l)}px`}
                  />
                </div>
              )),
            )}
          </div>
        </div>
      )
    }
  </div>
</section>
  )
}
