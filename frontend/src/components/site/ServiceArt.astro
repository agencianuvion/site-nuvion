---
// Small looping SVG illustrations for the three services (shown in the open accordion item of "Nossos serviços").
// Pure inline SVG + CSS animation (transform/opacity only): no JS, no image files, a few hundred bytes each.
// They only run while their item is open (the panel is closed → paused) and are switched off by reduced-motion.
interface Props {
  kind: number; // 0 site (browser being built), 1 SEO (ranking chart), 2 GEO (an answer being written), 3 funnel (visitors -> contacts), 4 network (a brand cited by many sources)
}
const { kind } = Astro.props;
---

<div class="svc-art" aria-hidden="true">
  {
    kind === 0 && (
      <svg viewBox="0 0 240 180" fill="none">
        <rect x="6" y="10" width="228" height="160" rx="12" class="line" />
        <path d="M6 36h228" class="line" />
        <circle cx="20" cy="23" r="3" class="dim" />
        <circle cx="31" cy="23" r="3" class="dim" />
        <circle cx="42" cy="23" r="3" class="dim" />
        <rect x="60" y="17" width="110" height="12" rx="6" class="line" />
        <rect x="60" y="17" width="110" height="12" rx="6" class="hot load" />
        <g class="build">
          <rect x="20" y="48" width="200" height="46" rx="8" class="fill" style="--d:0s" />
          <rect x="30" y="58" width="90" height="7" rx="3.5" class="strong" style="--d:0.25s" />
          <rect x="30" y="72" width="60" height="5" rx="2.5" class="dim-fill" style="--d:0.4s" />
          <rect x="30" y="82" width="34" height="8" rx="4" class="hot-fill" style="--d:0.55s" />
          <rect x="20" y="104" width="62" height="54" rx="8" class="fill" style="--d:0.7s" />
          <rect x="89" y="104" width="62" height="54" rx="8" class="fill" style="--d:0.85s" />
          <rect x="158" y="104" width="62" height="54" rx="8" class="fill" style="--d:1s" />
        </g>
        <g class="gauge">
          <circle cx="190" cy="71" r="17" class="line" />
          <circle cx="190" cy="71" r="17" class="hot ring" pathLength="1" />
          <path d="m183 71 5 5 9-10" class="hot" />
        </g>
      </svg>
    )
  }
  {
    kind === 1 && (
      <svg viewBox="0 0 240 180" fill="none">
        <path d="M14 150h214M14 110h214M14 70h214M14 30h214" class="grid" />
        <g class="bars">
          <rect x="26" y="112" width="20" height="38" rx="4" class="fill" style="--d:0s" />
          <rect x="62" y="98" width="20" height="52" rx="4" class="fill" style="--d:0.12s" />
          <rect x="98" y="104" width="20" height="46" rx="4" class="fill" style="--d:0.24s" />
          <rect x="134" y="76" width="20" height="74" rx="4" class="fill" style="--d:0.36s" />
          <rect x="170" y="56" width="20" height="94" rx="4" class="fill" style="--d:0.48s" />
          <rect x="206" y="34" width="20" height="116" rx="4" class="hot-fill" style="--d:0.6s" />
        </g>
        <path d="M36 100 72 84 108 92 144 62 180 44 216 22" class="hot trend" pathLength="1" />
        <g class="peak">
          <circle cx="216" cy="22" r="5" class="hot-fill" />
          <circle cx="216" cy="22" r="5" class="hot pulse" />
        </g>
      </svg>
    )
  }
  {
    kind === 2 && (
      <svg viewBox="0 0 240 180" fill="none">
        <g class="ask">
          <rect x="8" y="12" width="128" height="44" rx="14" class="line" />
          <rect x="22" y="26" width="86" height="6" rx="3" class="dim-fill" />
          <rect x="22" y="38" width="52" height="6" rx="3" class="dim-fill" />
        </g>
        <g class="answer">
          <rect x="52" y="70" width="180" height="98" rx="14" class="fill" />
          <rect x="66" y="86" width="150" height="6" rx="3" class="strong type" style="--d:0.6s" />
          <rect x="66" y="100" width="118" height="6" rx="3" class="strong type" style="--d:1.2s" />
          <rect x="66" y="114" width="132" height="6" rx="3" class="strong type" style="--d:1.8s" />
          <rect x="66" y="128" width="64" height="8" rx="4" class="hot-fill type" style="--d:2.4s" />
          <rect x="136" y="128" width="46" height="8" rx="4" class="dim-fill type" style="--d:2.8s" />
          <rect x="66" y="146" width="3" height="10" rx="1.5" class="hot-fill caret" />
        </g>
        <path d="M212 84l2.6 5.4 5.4 2.6-5.4 2.6-2.6 5.4-2.6-5.4-5.4-2.6 5.4-2.6z" class="hot-fill spark" />
      </svg>
    )
  }
  {
    kind === 3 && (
      <svg viewBox="0 0 400 240" fill="none">
        <path d="M36 26h328L246 128v40h-92v-40z" class="line" />
        <g class="visitors">
          <circle cx="70" cy="14" r="5" class="strong" style="--d:0s;--dx:52px" />
          <circle cx="112" cy="10" r="5" class="strong" style="--d:0.5s;--dx:34px" />
          <circle cx="156" cy="14" r="5" class="strong" style="--d:1s;--dx:14px" />
          <circle cx="204" cy="10" r="5" class="strong" style="--d:0.3s;--dx:-2px" />
          <circle cx="248" cy="14" r="5" class="strong" style="--d:0.8s;--dx:-30px" />
          <circle cx="292" cy="10" r="5" class="strong" style="--d:1.3s;--dx:-48px" />
          <circle cx="332" cy="14" r="5" class="strong" style="--d:0.15s;--dx:-68px" />
        </g>
        <g class="leads">
          <rect x="98" y="196" width="60" height="26" rx="13" class="hot-fill" style="--d:0s" />
          <rect x="170" y="196" width="60" height="26" rx="13" class="hot-fill" style="--d:0.7s" />
          <rect x="242" y="196" width="60" height="26" rx="13" class="hot-fill" style="--d:1.4s" />
          <path d="m120 209 5 5 9-10M192 209l5 5 9-10M264 209l5 5 9-10" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </g>
        <path d="M200 168v22" class="line" stroke-dasharray="3 4" />
      </svg>
    )
  }
  {
    kind === 4 && (
      <svg viewBox="0 0 400 240" fill="none">
        <g class="links">
          <path d="M200 120 70 56" class="line" />
          <path d="M200 120 84 190" class="line" />
          <path d="M200 120 338 52" class="line" />
          <path d="M200 120 326 194" class="line" />
          <path d="M200 120 200 22" class="line" />
        </g>
        <g class="flow">
          <path d="M70 56 200 120" class="hot" pathLength="1" style="--d:0s" />
          <path d="M84 190 200 120" class="hot" pathLength="1" style="--d:0.6s" />
          <path d="M338 52 200 120" class="hot" pathLength="1" style="--d:1.2s" />
          <path d="M326 194 200 120" class="hot" pathLength="1" style="--d:1.8s" />
          <path d="M200 22 200 120" class="hot" pathLength="1" style="--d:2.4s" />
        </g>
        <g class="src">
          <circle cx="70" cy="56" r="14" class="fill" />
          <circle cx="84" cy="190" r="14" class="fill" />
          <circle cx="338" cy="52" r="14" class="fill" />
          <circle cx="326" cy="194" r="14" class="fill" />
          <circle cx="200" cy="22" r="14" class="fill" />
        </g>
        <circle cx="200" cy="120" r="34" class="fill" />
        <circle cx="200" cy="120" r="34" class="hot ring2" />
        <circle cx="200" cy="120" r="11" class="hot-fill" />
      </svg>
    )
  }
</div>

<style>
  .svc-art {
    width: 100%;
    max-width: 260px;
    justify-self: center;
    align-self: center;
    color: #fff;
  }
  .svc-art svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .line {
    stroke: currentColor;
    stroke-opacity: 0.22;
    stroke-width: 1.3;
  }
  .grid {
    stroke: currentColor;
    stroke-opacity: 0.1;
    stroke-width: 1;
    stroke-dasharray: 2 5;
  }
  .dim {
    fill: currentColor;
    fill-opacity: 0.25;
  }
  .dim-fill {
    fill: currentColor;
    fill-opacity: 0.2;
  }
  .fill {
    fill: currentColor;
    fill-opacity: 0.08;
    stroke: currentColor;
    stroke-opacity: 0.12;
  }
  .strong {
    fill: currentColor;
    fill-opacity: 0.55;
  }
  .hot {
    stroke: #cc4e14;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .hot-fill {
    fill: #cc4e14;
  }

  /* everything shares one loop length so the parts stay in step */
  .build > *,
  .bars > *,
  .type,
  .load,
  .ring,
  .trend {
    animation-duration: 6s;
    animation-iteration-count: infinite;
    animation-timing-function: cubic-bezier(0.22, 0.61, 0.36, 1);
    animation-delay: var(--d, 0s);
  }
  .svc-art * {
    transform-box: fill-box;
  }
  /* paused while the item is closed */
  :global(.t3-svc:not(.is-open)) .svc-art * {
    animation-play-state: paused;
  }

  /* 0: the page builds itself, the address bar loads, the score ring completes */
  .build > * {
    transform-origin: 0 50%;
    animation-name: svc-build;
  }
  @keyframes svc-build {
    0% {
      opacity: 0;
      transform: translateY(8px);
    }
    12%,
    82% {
      opacity: 1;
      transform: none;
    }
    95%,
    100% {
      opacity: 0;
      transform: none;
    }
  }
  .load {
    transform-origin: 0 50%;
    animation-name: svc-load;
    animation-timing-function: ease-out;
  }
  @keyframes svc-load {
    0% {
      transform: scaleX(0);
      opacity: 1;
    }
    30% {
      transform: scaleX(1);
      opacity: 1;
    }
    80% {
      transform: scaleX(1);
      opacity: 1;
    }
    95%,
    100% {
      transform: scaleX(1);
      opacity: 0;
    }
  }
  .ring {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transform: rotate(-90deg);
    transform-origin: center;
    animation-name: svc-ring;
    animation-delay: 1.1s;
  }
  @keyframes svc-ring {
    0% {
      stroke-dashoffset: 1;
    }
    22%,
    82% {
      stroke-dashoffset: 0;
    }
    95%,
    100% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
  }

  /* 1: bars grow, the trend line is drawn over them, the last point pulses */
  .bars > * {
    transform-origin: 50% 100%;
    animation-name: svc-grow;
  }
  @keyframes svc-grow {
    0% {
      transform: scaleY(0);
      opacity: 0.4;
    }
    16%,
    82% {
      transform: scaleY(1);
      opacity: 1;
    }
    95%,
    100% {
      transform: scaleY(1);
      opacity: 0;
    }
  }
  .trend {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation-name: svc-draw;
    animation-delay: 0.5s;
  }
  @keyframes svc-draw {
    0% {
      stroke-dashoffset: 1;
      opacity: 1;
    }
    28%,
    82% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    95%,
    100% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
  }
  .peak {
    animation: svc-peak 6s infinite;
  }
  @keyframes svc-peak {
    0%,
    26% {
      opacity: 0;
    }
    32%,
    82% {
      opacity: 1;
    }
    95%,
    100% {
      opacity: 0;
    }
  }
  .pulse {
    transform-origin: center;
    animation: svc-pulse 1.8s ease-out infinite;
    fill: none;
  }
  @keyframes svc-pulse {
    from {
      transform: scale(1);
      opacity: 0.8;
    }
    to {
      transform: scale(3.2);
      opacity: 0;
    }
  }

  /* 3: visitors fall into the funnel and come out as contacts */
  .visitors > * {
    animation: svc-fall 4.8s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    animation-delay: var(--d, 0s);
    opacity: 0;
  }
  @keyframes svc-fall {
    0% {
      opacity: 0;
      transform: translate(0, 0);
    }
    12% {
      opacity: 1;
    }
    55% {
      opacity: 1;
      transform: translate(var(--dx, 0), 110px);
    }
    70%,
    100% {
      opacity: 0;
      transform: translate(0, 140px);
    }
  }
  .leads > rect {
    animation: svc-lead 4.8s ease-out infinite;
    animation-delay: calc(var(--d, 0s) + 1.4s);
    opacity: 0;
    transform-origin: 50% 50%;
  }
  @keyframes svc-lead {
    0% {
      opacity: 0;
      transform: scale(0.6);
    }
    14%,
    70% {
      opacity: 1;
      transform: scale(1);
    }
    90%,
    100% {
      opacity: 0;
      transform: scale(1);
    }
  }

  /* 4: sources feed the brand at the centre */
  .flow > * {
    stroke-dasharray: 0.22 1;
    stroke-dashoffset: 0.22;
    animation: svc-flow 3.6s linear infinite;
    animation-delay: var(--d, 0s);
  }
  @keyframes svc-flow {
    to {
      stroke-dashoffset: -1;
    }
  }
  .ring2 {
    transform-origin: center;
    animation: svc-pulse 2.6s ease-out infinite;
    fill: none;
  }

  /* 2: the question sits there, the answer is written line by line, the brand line is the orange one */
  .type {
    transform-origin: 0 50%;
    animation-name: svc-type;
  }
  @keyframes svc-type {
    0% {
      transform: scaleX(0);
      opacity: 1;
    }
    10%,
    82% {
      transform: scaleX(1);
      opacity: 1;
    }
    95%,
    100% {
      transform: scaleX(1);
      opacity: 0;
    }
  }
  .answer {
    animation: svc-answer 6s infinite;
  }
  @keyframes svc-answer {
    0%,
    8% {
      opacity: 0;
    }
    14%,
    88% {
      opacity: 1;
    }
    97%,
    100% {
      opacity: 0;
    }
  }
  .caret {
    animation: svc-blink 0.9s steps(1) infinite;
  }
  @keyframes svc-blink {
    50% {
      opacity: 0;
    }
  }
  .spark {
    transform-origin: center;
    animation: svc-spark 3s ease-in-out infinite;
  }
  @keyframes svc-spark {
    0%,
    100% {
      transform: scale(1) rotate(0);
      opacity: 0.9;
    }
    50% {
      transform: scale(1.25) rotate(20deg);
      opacity: 1;
    }
  }
</style>
