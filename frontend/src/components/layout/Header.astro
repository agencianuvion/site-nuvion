---
// Sticky glass header — the only place glassmorphism is used on this site
// (see PROJECT_PREFERENCES.md): background rgba(255,255,255,.42) + blur,
// meant to sit over the hero video and remain consistent on every other
// (plain white) page below it.
import { waLink } from "../../lib/contact";
import ThemeToggle from "../ui/ThemeToggle.astro";

const pathname = Astro.url.pathname;
const isActive = (path: string) =>
  path === "/" ? pathname === "/" : pathname === path || pathname.startsWith(`${path}/`);

const navLinks = [
  { href: "/sites-de-alta-performance", label: "Sites de Alta Performance" },
  { href: "/seo-tecnico", label: "SEO Técnico" },
  { href: "/geo", label: "Otimização Generativa" },
  { href: "/sobre-nos", label: "Sobre Nós" },
];
---

<header class="nv-glass sticky top-0 z-50 flex items-center justify-between px-6 py-4 sm:px-10">
  <a href="/" class="block shrink-0" aria-label="Nuvion, página inicial">
    <img src="/images/logo-horizontal-dark.png" alt="Nuvion" class="h-[22px] w-auto sm:h-[26px]" />
  </a>

  <nav class="hidden items-center gap-7 text-sm font-medium text-nv-graphite-500 lg:flex" aria-label="Main">
    {navLinks.map((link) => (
      <a href={link.href} class:list={["transition-colors hover:text-nv-graphite-900", { "text-nv-graphite-900": isActive(link.href) }]}>
        {link.label}
      </a>
    ))}
    <ThemeToggle />
    <a
      href={waLink("Olá! Quero agendar um diagnóstico com a Nuvion.")}
      target="_blank"
      rel="noopener"
      class="nv-cta inline-flex h-9 items-center justify-center whitespace-nowrap rounded-full bg-nv-orange px-5 text-sm font-semibold text-white"
    >
      Agendar Meu Diagnóstico
    </a>
  </nav>

  <div class="flex items-center gap-3 lg:hidden">
    <ThemeToggle />
    <button
      id="mobile-menu-toggle"
      type="button"
      aria-label="Menu"
      aria-haspopup="true"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6 text-nv-graphite-900" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <nav
    id="mobile-menu"
    class="nv-glass absolute left-0 right-0 top-full hidden flex-col gap-1 p-4 lg:hidden"
    aria-label="Main (mobile)"
  >
    {navLinks.map((link) => (
      <a href={link.href} class="rounded px-3 py-2 text-sm font-medium text-nv-graphite-700 hover:bg-black/5">
        {link.label}
      </a>
    ))}
    <a
      href={waLink("Olá! Quero agendar um diagnóstico com a Nuvion.")}
      target="_blank"
      rel="noopener"
      class="nv-cta mt-2 inline-flex h-10 items-center justify-center rounded-full bg-nv-orange px-5 text-sm font-semibold text-white"
    >
      Agendar Meu Diagnóstico
    </a>
  </nav>
</header>

<script>
  // Click-to-toggle (not just hover) so it works on touch; closes on an
  // outside click or on picking a link (this is a multi-page site — every
  // navigation is a full reload anyway, so closing first avoids the menu
  // visibly still being open for an instant mid-navigation).
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");

  toggle?.addEventListener("click", (event) => {
    event.stopPropagation();
    const isOpen = menu?.classList.toggle("flex");
    menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
  });

  document.addEventListener("click", (event) => {
    if (menu && !menu.classList.contains("hidden") && !menu.contains(event.target as Node) && event.target !== toggle) {
      menu.classList.add("hidden");
      menu.classList.remove("flex");
      toggle?.setAttribute("aria-expanded", "false");
    }
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.classList.add("hidden");
      menu.classList.remove("flex");
    });
  });
</script>
