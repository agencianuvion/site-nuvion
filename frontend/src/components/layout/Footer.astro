---
// Closing panel of every page: call to action, links, socials and legal links, with the Nuvion wordmark
// sliding in behind (animated in scripts/site.ts). Same skeleton as the Flowrix footer the client liked.
import { waLink } from "../../lib/contact";
import { footerLinkGroups, socials, legalLinks } from "../../lib/site";
---

<div class="t3 t3-foot">
  <section class="t3-panel t3-dark t3-cta" aria-labelledby="t3-cta-h">
    <img
      class="t3-cta-mark"
      src="/images/nuvion-wordmark.webp"
      alt=""
      width="2400"
      height="354"
      loading="lazy"
      decoding="async"
      aria-hidden="true"
    />
    <div class="t3-cta-top">
      <!-- Phones only: the logo⇄network morph (drag to rotate, tap to transform) sitting in its own space
           above the title — not a backdrop behind the text; only its own bottom edge is allowed to tuck
           slightly under the title (a small negative margin), not the whole thing. This panel is always dark
           regardless of site theme, so no light-theme palette is needed here. Lazily loaded only once this
           panel is about to scroll into view. -->
      <div class="t3-cta-morph-mobile" aria-hidden="true">
        <canvas class="t3-cta-morph-canvas"></canvas>
      </div>
      <script>
        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const lite = !window.matchMedia("(hover: hover) and (pointer: fine)").matches;
        const morphEl = document.querySelector<HTMLElement>(".t3-cta-morph-mobile");
        const morphCanvas = document.querySelector<HTMLCanvasElement>(".t3-cta-morph-canvas");
        if (morphEl && morphCanvas && lite && !reduced) {
          const io = new IntersectionObserver(
            ([entry]) => {
              if (!entry.isIntersecting) return;
              io.disconnect();
              import("../../scripts/logo-morph-mobile").then(({ initLogoMorphMobile }) =>
                initLogoMorphMobile({ canvas: morphCanvas, container: morphEl }),
              );
            },
            { rootMargin: "200px 0px" },
          );
          io.observe(morphEl);
        }
      </script>
      <h2 id="t3-cta-h" class="t3-cta-title">Vamos colocar a sua marca no topo das buscas, e nas respostas de IA?</h2>
      <div class="t3-cta-side">
        <span class="t3-chip"><i></i>Diagnóstico gratuito</span>
        <p>Agende um diagnóstico gratuito e descubra onde a sua arquitetura digital está perdendo oportunidades.</p>
        <a
          class="nv-cta t3-btn"
          href={waLink("Olá! Quero agendar meu diagnóstico gratuito com a Nuvion.")}
          target="_blank"
          rel="noopener">Falar no WhatsApp</a
        >
      </div>
    </div>

    <div class="t3-cta-mid">
      <nav aria-label="Rodapé">
        {
          footerLinkGroups.map((g) => (
            <div class="t3-foot-group">
              <p class="t3-foot-label">{g.label}</p>
              {g.links.map((l) => <a href={l.href}>{l.label}</a>)}
            </div>
          ))
        }
      </nav>
      <div class="t3-socials">
        {
          socials.map((so) => (
            <a href={so.href} target="_blank" rel="noopener" aria-label={so.label}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={so.icon} />
            </a>
          ))
        }
      </div>
    </div>

    <div class="t3-cta-bot">
      <p>&copy; {new Date().getFullYear()} Nuvion.<span> Todos os direitos reservados.</span></p>
      <nav aria-label="Legal">
        {legalLinks.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
      <!-- Phones only (the home is a long scroll there): closes the footer with a way back up. -->
      <button type="button" class="t3-totop" aria-label="Voltar ao topo">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
      </button>
      <script>
        document.querySelector(".t3-totop")?.addEventListener("click", () => {
          const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          window.scrollTo({ top: 0, behavior: reduced ? "auto" : "smooth" });
        });
      </script>
    </div>
  </section>
</div>
