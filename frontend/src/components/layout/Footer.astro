---
const year = new Date().getFullYear();

const navLinks = [
  { href: "/sites-de-alta-performance", label: "Sites de Alta Performance" },
  { href: "/seo-tecnico", label: "SEO Técnico" },
  { href: "/geo", label: "Otimização Generativa" },
  { href: "/sobre-nos", label: "Sobre Nós" },
  { href: "/blog", label: "Blog" },
];
---

<footer class="border-t border-nv-hairline bg-nv-offwhite-light px-6 py-10 sm:px-10">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
    <a href="/" class="block shrink-0" aria-label="Nuvion, página inicial">
      <img src="/images/logo-horizontal-dark.png" alt="Nuvion" class="h-5 w-auto" />
    </a>

    <nav class="flex flex-wrap gap-x-5 gap-y-1 text-sm text-nv-graphite-600" aria-label="Footer">
      {navLinks.map((link) => (
        <a href={link.href} class="whitespace-nowrap transition-colors hover:text-nv-graphite-900">
          {link.label}
        </a>
      ))}
    </nav>

    <p class="text-xs text-nv-graphite-400">&copy; {year} Nuvion. Todos os direitos reservados.</p>
  </div>
</footer>
