---
// GEO didn't exist on the old site (it's the new pillar replacing "Gestão
// de Tráfego" — see project memory), so this content is written fresh
// rather than adapted. Practices described here are real, not aspirational
// copy: this very site ships FAQPage/Organization schema and an llms.txt
// (see public/llms.txt) as a working example, not a claim.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/shared/PageHero.astro";
import FinalCta from "../components/home/FinalCta.astro";

const practices = [
  {
    title: "Dados estruturados",
    description: "Schema.org em cada página (organização, perguntas frequentes, artigos) pra IA entender exatamente do que se trata cada conteúdo, sem adivinhar.",
    icon: `<circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>`,
  },
  {
    title: "Conteúdo pensado pra ser citado",
    description: "Respostas diretas, bem tituladas e fáceis de extrair. É isso que faz um modelo de linguagem escolher citar a sua marca em vez da concorrência.",
    icon: `<polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline>`,
  },
  {
    title: "Clareza de entidade",
    description: "Deixamos claro pra IA quem você é, o que faz e onde atua, com consistência entre o site, o Google Business e as redes sociais.",
    icon: `<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>`,
  },
  {
    title: "llms.txt e acesso a crawlers de IA",
    description: "Garantimos que ChatGPT, Perplexity e outros crawlers de IA consigam acessar e entender o seu conteúdo, em vez de bloquear sem querer.",
    icon: `<rect x="2.5" y="3.5" width="19" height="13.5" rx="2.2"></rect><path d="M12 17v3.5M8.6 20.5h6.8"></path>`,
  },
];
---

<BaseLayout
  title="GEO (Generative Engine Optimization) — Nuvion"
  description="Otimização Generativa: prepare sua marca para aparecer como resposta nas buscas feitas por ChatGPT, Perplexity e outras IAs generativas."
>
  <PageHero
    eyebrow="Otimização Generativa (GEO)"
    description="O Google não é mais o único lugar onde as pessoas buscam. A gente prepara sua marca pra aparecer também na resposta que a IA generativa dá."
    ctaLabel="Quero Aparecer nas Respostas de IA"
    waMessage="Olá! Quero saber mais sobre GEO com a Nuvion."
  >
    Sua marca também precisa aparecer <strong>na resposta da IA.</strong>
  </PageHero>

  <section class="bg-nv-offwhite-light py-20 sm:py-24">
    <div class="mx-auto max-w-3xl px-6 text-center sm:px-10">
      <p class="text-pretty text-lg leading-[1.62] text-nv-graphite-700">
        Cada vez mais gente pergunta pro ChatGPT, pro Perplexity ou pro Google AI Overviews em vez de rolar dez links
        azuis. GEO é o trabalho de preparar o seu site pra ser a fonte que essas IAs escolhem citar, com a mesma
        seriedade técnica que aplicamos em SEO.
      </p>
    </div>

    <div class="mx-auto mt-14 grid max-w-5xl grid-cols-1 gap-6 px-6 sm:grid-cols-2 sm:px-10">
      {practices.map((practice) => (
        <div class="flex gap-5 rounded-3xl border border-nv-hairline bg-white p-7 shadow-[0_2px_8px_rgba(30,30,30,.06)]">
          <div class="flex h-11 w-11 flex-none items-center justify-center rounded-full border border-nv-orange/30 text-nv-orange">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" set:html={practice.icon} />
          </div>
          <div>
            <h3 class="text-base font-semibold tracking-[-0.02em] text-nv-graphite-900">{practice.title}</h3>
            <p class="mt-2 text-pretty text-sm leading-[1.62] text-nv-graphite-600">{practice.description}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-white py-20 text-center sm:py-24">
    <div class="mx-auto max-w-2xl px-6 sm:px-10">
      <span class="text-xs font-semibold uppercase tracking-[0.32em] text-nv-orange sm:text-sm">Aliás</span>
      <p class="nv-h1 mt-4 text-pretty text-[22px] text-nv-graphite-900 sm:text-[28px]">
        Este próprio site é construído com essas práticas: dados estruturados, conteúdo direto e um arquivo llms.txt
        orientando os crawlers de IA. Não é promessa, é o que está no ar agora.
      </p>
    </div>
  </section>

  <FinalCta
    eyebrow="Vamos preparar sua marca"
    description="Conte pra gente o que você já faz hoje em SEO e a gente te mostra onde o GEO entra pra somar."
    buttonLabel="Quero Entender o GEO na Prática"
    waMessage="Olá! Quero entender como o GEO pode ajudar a minha marca."
  />
</BaseLayout>
