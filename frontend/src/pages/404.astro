---
// A dedicated 404, not the generic PageHero every other page uses — on-brand joke for an SEO/GEO agency: a fake
// "search with zero results" for the URL that doesn't exist, with a few real links styled like search results.
import BaseLayout from "../layouts/BaseLayout.astro";
import { waLink } from "../lib/contact";
---

<BaseLayout title="Página não encontrada — Nuvion" description="A página que você procura não existe ou mudou de endereço." noindex>
  <main class="t3">
    <section class="t3-panel t3-dark nf" aria-labelledby="nf-h1">
      <div class="ph-bg" aria-hidden="true"></div>
      <div class="nf-in">
        <span class="t3-chip" style="padding-top:0"><i></i>Erro 404</span>
        <h1 id="nf-h1" class="nf-title">Essa página <em>não existe.</em></h1>

        <div class="nf-search">
          <svg class="nf-search-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <span class="nf-search-text">
            <span data-nf-url>/</span><span class="nf-caret" aria-hidden="true">|</span>
          </span>
        </div>
        <p class="nf-zero">
          0 resultados encontrados. Nem a gente, que é especialista em SEO e GEO, conseguiu indexar essa página.
        </p>

        <div class="nf-suggest">
          <a class="bx-card nf-page" href="/">
            <span class="nf-page-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9.5 12 3l9 6.5V21a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z"></path>
              </svg>
            </span>
            <h3>Início</h3>
            <p>Sites de alta performance, SEO técnico e GEO. Comece por aqui.</p>
          </a>
          <a class="bx-card nf-page" href="/blog">
            <span class="nf-page-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
              </svg>
            </span>
            <h3>Blog</h3>
            <p>Artigos sobre arquitetura de site, SEO técnico e otimização para IAs.</p>
          </a>
        </div>

        <aside class="t3-article-cta nf-wa">
          <div>
            <h2>Prefere resolver direto?</h2>
            <p>Manda uma mensagem pra gente no WhatsApp e a conversa já começa.</p>
          </div>
          <a class="rs-cta-link nf-wa-link" href={waLink("Olá! Cheguei numa página que não existe no site e queria falar com vocês.")} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"></path>
              <path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"></path>
            </svg>
            Falar no WhatsApp
          </a>
        </aside>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  // The 404 route is static (same build for every broken URL), so the URL itself only exists client-side —
  // "typed into" the fake search bar once the real page (and JS) has loaded.
  const el = document.querySelector<HTMLElement>("[data-nf-url]");
  if (el && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const path = location.pathname && location.pathname !== "/" ? location.pathname : "/pagina-que-voce-tentou-abrir";
    let i = 0;
    el.textContent = "";
    const type = () => {
      el.textContent = path.slice(0, i);
      i++;
      if (i <= path.length) setTimeout(type, 45);
    };
    type();
  } else if (el) {
    el.textContent = location.pathname && location.pathname !== "/" ? location.pathname : "/pagina-que-voce-tentou-abrir";
  }
</script>

<style>
  .nf {
    display: flex;
    align-items: center;
    min-height: calc(90vh - var(--t3-gap));
    min-height: calc(90svh - var(--t3-gap));
  }
  .nf-in {
    position: relative;
    z-index: 1;
    max-width: 640px;
    margin: 0 auto;
    padding: clamp(40px, 6vw, 72px) clamp(20px, 4vw, 40px);
    text-align: center;
  }
  .nf-title {
    margin: 18px 0 36px;
    font-size: clamp(32px, 5vw, 54px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.08;
  }
  .nf-title em {
    font-style: normal;
    color: var(--color-nv-orange);
  }
  .nf-search {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 15px 22px;
    border-radius: 999px;
    background: #fff;
    color: #111;
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.35);
  }
  .nf-search-ico {
    width: 19px;
    height: 19px;
    flex: none;
    color: #8a8a8a;
  }
  .nf-search-text {
    overflow: hidden;
    white-space: nowrap;
    font-family: var(--t3-mono);
    font-size: 14px;
    text-align: left;
  }
  .nf-caret {
    animation: nf-blink 1s step-end infinite;
  }
  @keyframes nf-blink {
    50% {
      opacity: 0;
    }
  }
  .nf-zero {
    margin: 22px 0 0;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.6);
  }
  .nf-suggest {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: 32px;
    text-align: left;
  }
  /* .bx-card already gives the border/background/hover-lift (and its own dark-panel variant); this just lays out
     the icon + heading + text inside it. */
  .nf-page {
    align-items: flex-start;
    gap: 10px;
    text-decoration: none;
    color: inherit;
  }
  .nf-page-ico {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-nv-orange);
  }
  .nf-page-ico svg {
    width: 20px;
    height: 20px;
  }
  .nf-page h3 {
    margin: 2px 0 0;
    font-size: 16px;
    font-weight: 600;
  }
  .nf-page p {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.62);
  }
  /* WhatsApp gets its own moment instead of blending into the "search result" list — reuses the same orange CTA
     card as the end of every blog article (.t3-article-cta/.rs-cta-link). */
  .nf-wa {
    margin-top: 16px;
    text-align: left;
  }
  .nf-wa-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }
  @media (max-width: 560px) {
    .nf-search-text {
      font-size: 12.5px;
    }
    .nf-suggest {
      grid-template-columns: 1fr;
    }
  }
</style>
