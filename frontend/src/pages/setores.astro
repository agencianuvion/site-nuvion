---
// Sectors hub. The list itself lives in the SectorsSection component (layout the client liked on the old home);
// its copy was inferred from the names of the client logos we were given, so review it before publishing.
// When individual sector pages exist (only for sectors with real cases), link each item to its page.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/shared/PageHero.astro";
import Bento from "../components/site/Bento.astro";
import FeatureGrid from "../components/site/FeatureGrid.astro";
import FaqSection from "../components/site/FaqSection.astro";
import SectorsSection from "../components/test3/SectorsSection.astro";
import { faqSchema } from "../lib/faq";
import { buildBreadcrumbSchema } from "../lib/breadcrumbs";
import { sectorIcons, sectorIconWild } from "../lib/sector-icons";

const siteUrl = (Astro.site ?? Astro.url).href;
const crumbs = [{ label: "Início", href: "/" }, { label: "Setores" }];

const changes = [
  {
    num: "01",
    title: "O público",
    text: "Quem compra de uma clínica não pesquisa como quem contrata uma construtora. Entendemos como o seu cliente decide antes de desenhar o site.",
  },
  {
    num: "02",
    title: "A busca",
    text: "Cada segmento tem as suas palavras, perguntas e intenções. É isso que define a estrutura e o conteúdo, não um modelo pronto.",
  },
  {
    num: "03",
    title: "A concorrência",
    text: "Olhamos quem já aparece no Google e nas respostas das IAs no seu mercado, para achar o espaço que ainda está aberto.",
  },
];

const faqs = [
  {
    question: "A Nuvion atende o meu segmento?",
    answer:
      "Trabalhamos com qualquer modelo de negócio. Os setores desta página são onde temos mais experiência, mas o método é o mesmo para todos e se adapta ao seu público e à sua busca.",
  },
  {
    question: "Preciso ter um site para começar?",
    answer:
      "Não. Se você ainda não tem site, planejamos e criamos um já pronto para ser encontrado. Se já tem, analisamos o que existe e decidimos junto o que aproveitar.",
  },
  {
    question: "O trabalho muda de um setor para outro?",
    answer:
      "A base técnica não muda: um site rápido, bem estruturado e pensado para ser encontrado. O que muda é o público, as palavras que ele usa para buscar e a concorrência de cada mercado.",
  },
  {
    question: "O conteúdo do site é genérico ou pensado para o meu nicho?",
    answer:
      "É pensado para o seu nicho. A pesquisa de palavras-chave, a estrutura das páginas e os exemplos usados no texto partem de como o seu público específico busca e decide, não de um modelo genérico reaproveitado para qualquer segmento.",
  },
  {
    question: "Setores regulados, como saúde e direito, têm alguma restrição de conteúdo?",
    answer:
      "Sim, e cuidamos disso. Conselhos como CFM, CRO e OAB têm regras próprias sobre o que pode ou não aparecer em publicidade profissional. Ajustamos o texto e as promessas do site para respeitar essas regras, sem perder força na comunicação.",
  },
  {
    question: "Minha empresa é pequena e local. Ainda vale a pena?",
    answer:
      "Vale, e costuma valer ainda mais rápido. SEO local (Google Meu Negócio, buscas por “perto de mim”, termos com a cidade ou região) traz resultado mais cedo para um negócio local do que para quem disputa termos nacionais.",
  },
  {
    question: "Meus concorrentes já investem pesado em anúncio pago. Ainda vale a pena investir em SEO?",
    answer:
      "Vale ainda mais. Anúncio pago some assim que você para de pagar; um site bem posicionado continua trazendo cliente de graça meses e anos depois. Muitos negócios usam os dois juntos, mas SEO é o que sobra quando o orçamento de mídia acaba.",
  },
  {
    question: "Quanto tempo leva para ver resultado no meu setor?",
    answer:
      "Varia com a concorrência: setores menos disputados costumam mostrar sinal em 2 a 3 meses; mercados mais concorridos levam mais tempo. Esse prazo é definido junto com você, no diagnóstico inicial, específico para o seu mercado.",
  },
];
const sectorNames = ["Saúde e estética", "Construção e imobiliário", "Indústria e serviços técnicos", "Moda e varejo", "Gastronomia e turismo", "Educação e associações"];

---

<BaseLayout
  title="Setores atendidos — Nuvion"
  description="Saúde, construção, indústria, varejo, gastronomia e educação: veja os setores onde a Nuvion mais tem experiência em sites, SEO técnico e GEO."
  jsonLd={[buildBreadcrumbSchema(crumbs, Astro.url.href, siteUrl), faqSchema(faqs)]}
>
  <main class="t3">
    <PageHero
      eyebrow="Setores"
      crumbs={crumbs}
      description="O método é o mesmo; o público e a busca mudam. Veja em quais mercados a Nuvion mais tem experiência."
      ctaLabel="Falar sobre o meu setor"
      waMessage="Olá! Quero conversar sobre um site para o meu negócio."
    >
      Sites e buscas para <em>o seu setor.</em>
      <div slot="visual" class="ph-orbit-wrap">
        <div class="orbit" style={`--n:${sectorNames.length + 1}`}>
          <div class="orbit-hub-wrap">
            <img class="orbit-hub" src="/images/mark-nuvion.png" alt="" width="72" height="72" />
          </div>
          {[...sectorNames, "Outro modelo de negócio"].map((n, i) => (
            <div class="orbit-arm" style={`--i:${i}`}>
              <div class="orbit-item" style={`--i:${i}`}>
                <span class:list={["orbit-ico", { "is-wild": i === sectorNames.length }]} set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">${i === sectorNames.length ? sectorIconWild : sectorIcons[i]}</svg>`} />
                <span class="orbit-tip">{n}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </PageHero>

    <Bento
      id="setores-muda"
      cols={3}
      title="O que muda de um setor para"
      em="outro"
      chip="Adaptação"
      items={changes.map((c, i) => ({ num: c.num, title: c.title, text: c.text, ...(i === 1 ? { hot: true } : {}) }))}
    />

    <SectorsSection />

    <FaqSection items={faqs} />
  </main>
</BaseLayout>
