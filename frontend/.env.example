# Copy this file to ".env" (not committed) for local development, and set
# the same values as GitHub Actions secrets for production builds — see
# .github/workflows/deploy.yml.

# The headless WordPress install's REST API, ending in /wp-json/wp/v2
# (no trailing slash after that).
PUBLIC_WP_API_URL=https://system.agencianuvion.com.br/wp-json/wp/v2
